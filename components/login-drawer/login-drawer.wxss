/* components/login-drawer/login-drawer.wxss */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;          /* 隐藏时不挡操作 */
  transition: opacity 0.2s ease-out;
}

.drawer-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.drawer-panel {
  position: relative;
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 64rpx 56rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
  transform: translateY(100%);   /* 默认藏在屏幕外 */
  transition: transform 0.24s ease-out;
}

.drawer-mask.is-visible .drawer-panel {
  transform: translateY(0);
}

.drawer-close {
  position: absolute;
  top: 28rpx;
  right: 32rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #B0AFA8;
}

/* ---------- 品牌区 ---------- */
.drawer-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.drawer-logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  background: #4A9D7E;
  color: #fff;
  font-size: 60rpx;
  line-height: 108rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.drawer-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2B2A26;
}

.drawer-slogan {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9B9A93;
}

/* ---------- 头像昵称选填 ---------- */
.drawer-profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 16rpx;
}

.avatar-btn {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #F1EFE8;
  overflow: visible;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: block;
}

.avatar-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #F1EFE8;
  font-size: 48rpx;
  line-height: 108rpx;
  text-align: center;
  color: #B0AFA8;
}

.avatar-plus {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4A9D7E;
  color: #fff;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.nickname-input {
  flex: 1;
  height: 92rpx;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: #F7F5F0;
  font-size: 28rpx;
  color: #2B2A26;
}

.nickname-placeholder {
  color: #B0AFA8;
}

.drawer-optional-hint {
  margin-bottom: 32rpx;
  font-size: 22rpx;
  color: #B0AFA8;
  text-align: center;
}

/* ---------- 登录按钮 ---------- */
.drawer-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #4A9D7E;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
}

.drawer-btn::after {
  border: none;
}

.drawer-btn:active {
  transform: scale(0.98);
}

.drawer-btn.is-loading {
  opacity: 0.7;
}

.drawer-btn[disabled] {
  color: #fff;
  background: #4A9D7E;
}

/* ---------- 协议 ---------- */
.drawer-agreement {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
}

.agreement-link {
  color: #4A9D7E;
}
