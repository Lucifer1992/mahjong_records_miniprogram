/* components/login-drawer/login-drawer.wxss */

/* ========== 通用遮罩 / 抽屉 ========== */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease-out;
}

.drawer-mask.is-visible {
  opacity: 1;
  pointer-events: auto;
}

.drawer-panel {
  position: relative;
  width: 100%;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 56rpx 56rpx calc(env(safe-area-inset-bottom) + 40rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.24s ease-out;
}

.drawer-mask.is-visible .drawer-panel {
  transform: translateY(0);
}

/* 主抽屉更紧凑：上下 padding 缩小 */
.drawer-panel-main {
  padding-top: 48rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 32rpx);
}

/* 子抽屉更紧凑 */
.drawer-panel-profile {
  padding-top: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.drawer-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #B0AFA8;
}

/* ========== 品牌区 ========== */
.drawer-brand {
  text-align: center;
  margin-bottom: 28rpx;
}

.drawer-logo {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #4A9D7E, #3A8A6A);
  border-radius: 28rpx;
  margin: 0 auto 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 157, 126, 0.35);
}

.drawer-logo-inner {
  width: 60rpx;
  height: 60rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.drawer-logo-inner::after {
  content: '';
  width: 28rpx;
  height: 28rpx;
  background: #4A9D7E;
  border-radius: 8rpx;
}

.drawer-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2B2A26;
  text-align: center;
}

.drawer-slogan {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9B9A93;
  text-align: center;
}

/* ========== 好处列表 ========== */
.drawer-benefits {
  background: #F7F5F0;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.benefit-item + .benefit-item {
  margin-top: 20rpx;
}

.benefit-icon {
  width: 52rpx;
  height: 52rpx;
  background: #E1F5EE;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.benefit-icon-dot {
  width: 26rpx;
  height: 26rpx;
  background: #4A9D7E;
  border-radius: 8rpx;
}

.benefit-text {
  flex: 1;
  min-width: 0;
}

.benefit-title {
  font-size: 26rpx;
  color: #2B2A26;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.benefit-sub {
  font-size: 22rpx;
  color: #9B9A93;
  margin-top: 2rpx;
}

/* ========== 文案 ========== */
.drawer-sub {
  margin-top: 10rpx;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  color: #9B9A93;
  text-align: center;
}

.drawer-panel-profile .drawer-sub {
  margin-bottom: 28rpx;
}

/* ========== 主登录按钮 ========== */
.drawer-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: #4A9D7E;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  margin: 0;
  padding: 0;
}

.drawer-btn::after {
  border: none;
}

.drawer-btn:active {
  transform: scale(0.98);
}

.drawer-btn.is-loading {
  opacity: 0.7;
}

/* 微信绿按钮 */
.drawer-btn-wechat {
  background: #07C160;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-wechat-icon {
  width: 36rpx;
  height: 36rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-wechat-icon::after {
  content: '';
  width: 18rpx;
  height: 18rpx;
  background: #07C160;
  border-radius: 50%;
}

/* ========== 协议 ========== */
.drawer-agreement {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0AFA8;
}

.agreement-link {
  color: #4A9D7E;
}

/* ========== 完善资料子抽屉 ========== */
.drawer-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

/*
 * 微信 chooseAvatar button 自带默认样式（椭圆灰底 + 内边距），无法通过常规 CSS 完全清除。
 * 解决：button 透明、padding 归零；用一个 .avatar-mask 同尺寸圆形覆盖在 button 内部，盖住默认椭圆；
 * image / placeholder-icon 仍然是 button 直接子节点（必须，否则拿不到头像 URL）。
 */
.avatar-btn {
  position: relative;
  width: 96rpx !important;
  height: 96rpx !important;
  padding: 0 !important;
  margin: 0 0 20rpx;
  border-radius: 50%;
  background: transparent !important;
  overflow: hidden;
  flex-shrink: 0;
  line-height: 1;
  font-size: 0;          /* 兜底清除 button 文字间距 */
  text-align: center;
}

.avatar-btn::after {
  border: none !important;
  display: none !important;
  width: 0;
  height: 0;
  content: none;
}

/* 视觉圆形：覆盖 button 默认椭圆，露出干净的圆形头像区 */
.avatar-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F1EFE8;
  z-index: 0;
}

.avatar-img {
  position: relative;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: block;
}

.avatar-placeholder-icon {
  position: relative;
  z-index: 1;
  font-size: 44rpx;
  color: #B0AFA8;
  line-height: 96rpx;
}

/* 头像右下"编辑"小标签：扁平、低饱和，避免"+"符号带来的杂乱感 */
.avatar-edit-tag {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  padding: 2rpx 10rpx;
  border-radius: 14rpx;
  background: #4A9D7E;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.2;
  white-space: nowrap;
  z-index: 2;
}

/* 昵称输入框：全宽，文字居左，加内部留白更舒服 */
.nickname-input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #F7F5F0;
  font-size: 26rpx;
  color: #2B2A26;
  text-align: left;
  border: 2rpx solid transparent;
  transition: border-color 0.15s;
}

.nickname-input:focus {
  border-color: #4A9D7E;
  background: #FFFFFF;
}

.nickname-placeholder {
  color: #B0AFA8;
}

.drawer-skip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9B9A93;
  letter-spacing: 1rpx;
}

.drawer-skip:active {
  opacity: 0.6;
}