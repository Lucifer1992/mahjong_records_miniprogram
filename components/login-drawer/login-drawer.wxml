<!-- components/login-drawer/login-drawer.wxml -->
<!-- 主抽屉：精简版，只负责登录本身 -->
<view class="drawer-mask {{ visible ? 'is-visible' : '' }}" bindtap="onMaskTap">
  <view class="drawer-panel drawer-panel-main" catchtap="noop">
    <view class="drawer-close" bindtap="hide">✕</view>

    <!-- Logo + 品牌区 -->
    <view class="drawer-brand">
      <view class="drawer-logo">
        <view class="drawer-logo-inner"></view>
      </view>
      <view class="drawer-title">登录雀战录</view>
      <view class="drawer-slogan">记录每一局的荣耀</view>
    </view>

    <!-- 好处列表 -->
    <view class="drawer-benefits">
      <view class="benefit-item">
        <view class="benefit-icon">
          <view class="benefit-icon-dot"></view>
        </view>
        <view class="benefit-text">
          <view class="benefit-title">战绩自动备份，换手机不丢失</view>
          <view class="benefit-sub">所有战绩安全存储</view>
        </view>
      </view>
      <view class="benefit-item">
        <view class="benefit-icon">
          <view class="benefit-icon-dot"></view>
        </view>
        <view class="benefit-text">
          <view class="benefit-title">福星克星分析</view>
          <view class="benefit-sub">AI 智能分析牌友关系</view>
        </view>
      </view>
    </view>

    <button class="drawer-btn drawer-btn-wechat {{ loading ? 'is-loading' : '' }}"
            bindtap="onLoginTap"
            disabled="{{ loading }}">
      <view class="btn-wechat-icon"></view>
      {{ loading ? '登录中…' : '微信一键登录' }}
    </button>

    <view class="drawer-agreement">
      <text>登录即代表同意</text>
      <text class="agreement-link" bindtap="onTermsTap">《服务条款》</text>
      <text>和</text>
      <text class="agreement-link" bindtap="onPrivacyTap">《隐私政策》</text>
    </view>
  </view>
</view>

<!-- 完善资料子抽屉：登录成功后弹出，可跳过 -->
<view class="drawer-mask {{ profileVisible ? 'is-visible' : '' }}" bindtap="onProfileMaskTap">
  <view class="drawer-panel drawer-panel-profile" catchtap="noop">
    <view class="drawer-close" bindtap="skipProfile">✕</view>

    <view class="drawer-title">完善账户信息</view>
    <view class="drawer-sub">选填，用于「我的」页账户展示</view>

    <!-- 头像 + 昵称：垂直居中布局，下方一个大输入框 -->
    <view class="drawer-profile">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <!-- image 必须是 button 直接子节点才能拿到头像 URL -->
        <image wx:if="{{ avatarPath }}" class="avatar-img" src="{{ avatarPath }}" mode="aspectFill" />
        <text wx:else class="avatar-placeholder-icon">👤</text>
        <!-- 视觉覆盖层：画一个 144rpx 圆 + 编辑标签，盖住 button 默认椭圆样式 -->
        <view class="avatar-mask"></view>
        <view class="avatar-edit-tag">编辑</view>
      </button>
      <input class="nickname-input"
             type="nickname"
             placeholder="微信昵称（选填）"
             placeholder-class="nickname-placeholder"
             value="{{ nickname }}"
             bindinput="onNicknameInput"
             maxlength="20" />
    </view>

    <button class="drawer-btn drawer-btn-primary" bindtap="onSaveProfile">
      保存
    </button>
    <view class="drawer-skip" bindtap="skipProfile">暂不填写</view>
  </view>
</view>