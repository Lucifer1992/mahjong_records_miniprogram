<!-- pages/analysis/analysis.wxml -->
<view class="page">

  <!-- Tab 切换 -->
  <view class="tab-pill">
    <view wx:for="{{ tabs }}" wx:key="id"
          class="tab-pill-item {{ activeTab === item.id ? 'tab-pill-active' : '' }} {{ item.proOnly ? 'tab-pill-pro' : '' }}"
          data-tab="{{ item.id }}"
          bindtap="onTabChange">
      <text class="tab-pill-emoji">{{ item.icon }}</text>
      <text>{{ item.name }}</text>
      <text wx:if="{{ item.proOnly && !isPro }}" class="tab-pill-lock">🔒</text>
    </view>
  </view>

  <!-- 总战绩概览 -->
  <view class="overview-card section-card">
    <view class="overview-row">
      <view class="overview-item">
        <view class="overview-num">{{ totalGames }}</view>
        <view class="overview-label">累计场次</view>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <view class="overview-num">{{ players.length }}</view>
        <view class="overview-label">牌友数</view>
      </view>
      <view class="overview-divider"></view>
      <view class="overview-item">
        <view class="overview-num">{{ relevantGames }}</view>
        <view class="overview-label">相关场次</view>
      </view>
    </view>
  </view>

  <!-- ============ 福星克星 Tab ============ -->
  <view wx:if="{{ activeTab === 'fortune' }}" class="fortune-tab">

    <!-- 玩家选择 -->
    <view wx:if="{{ players.length > 0 }}" class="player-picker section-card" bindtap="onPickerTap">
      <view class="player-picker-left">
        <view class="avatar avatar-md avatar-grad-1">?</view>
        <view>
          <view class="picker-label">查看玩家</view>
          <view class="picker-sub">{{ players[selectedPlayerIndex].nickname }}</view>
        </view>
      </view>
      <text class="picker-arrow">⌄</text>
    </view>

    <!-- 数据不足 -->
    <view wx:if="{{ !enoughData && players.length > 0 }}" class="empty-state">
      <view class="empty-illustration"><text class="empty-emoji">🎲</text></view>
      <text class="empty-title">战绩数据不足</text>
      <text class="empty-subtitle">福星克星分析至少需要 3 场战绩</text>
      <text class="empty-tip">当前 {{ totalGames }} 场，再来 {{ 3 - totalGames }} 场即可解锁</text>
    </view>

    <!-- 旺友区 -->
    <view wx:elif="{{ analysis }}" class="section-card">
      <view class="section-header">
        <view class="section-icon-wrap section-icon-lucky">⭐</view>
        <view class="section-title-wrap">
          <text class="section-title">你的旺友</text>
          <text class="section-sub">同坐战绩明显占优</text>
        </view>
      </view>

      <view wx:if="{{ analysis.luckyPartners.length === 0 }}" class="empty-mini">
        暂无可识别旺友，继续打几场吧
      </view>

      <view wx:else class="fortune-list">
        <view wx:for="{{ luckyList }}" wx:key="partnerId"
              class="fortune-row fortune-lucky">
          <view class="fortune-rank rank-{{ index + 1 }}">
            <text wx:if="{{ index === 0 }}">🥇</text>
            <text wx:elif="{{ index === 1 }}">🥈</text>
            <text wx:elif="{{ index === 2 }}">🥉</text>
            <text wx:else>{{ index + 1 }}</text>
          </view>
          <view class="fortune-info">
            <view class="fortune-nick">{{ item.partnerNickname }}</view>
            <view class="fortune-meta">
              <text class="meta-tag">同桌 {{ item.gamesTogether }} 次</text>
              <text class="meta-tag meta-tag-success">你胜率 {{ item.winRateText }}</text>
            </view>
          </view>
          <view class="fortune-score-wrap">
            <view class="fortune-score t-success">{{ item.netScoreText }}</view>
            <view class="fortune-score-label">你净胜分</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 克星区 -->
    <view wx:if="{{ analysis && analysis.luckyPartners.length > 0 }}" class="section-gap"></view>

    <view wx:if="{{ analysis }}" class="section-card">
      <view class="section-header">
        <view class="section-icon-wrap section-icon-evil">⚡</view>
        <view class="section-title-wrap">
          <text class="section-title">你的克星</text>
          <text class="section-sub">同坐容易翻车</text>
        </view>
      </view>

      <view wx:if="{{ analysis.evilPartners.length === 0 }}" class="empty-mini">
        暂无克星 · 你真的很强 🎉
      </view>

      <view wx:else class="fortune-list">
        <view wx:for="{{ evilList }}" wx:key="partnerId"
              class="fortune-row fortune-evil">
          <view class="fortune-rank rank-{{ index + 1 }}">
            <text wx:if="{{ index === 0 }}">🥇</text>
            <text wx:elif="{{ index === 1 }}">🥈</text>
            <text wx:elif="{{ index === 2 }}">🥉</text>
            <text wx:else>{{ index + 1 }}</text>
          </view>
          <view class="fortune-info">
            <view class="fortune-nick">{{ item.partnerNickname }}</view>
            <view class="fortune-meta">
              <text class="meta-tag">同桌 {{ item.gamesTogether }} 次</text>
              <text class="meta-tag meta-tag-danger">你胜率 {{ item.winRateText }}</text>
            </view>
          </view>
          <view class="fortune-score-wrap">
            <view class="fortune-score t-danger">{{ item.netScoreText }}</view>
            <view class="fortune-score-label">你净胜分</view>
          </view>
        </view>

        <!-- 免费版锁定态：TOP1 之外隐藏，看广告或升 Pro 解锁 -->
        <view wx:if="{{ fortuneLocked && evilHiddenCount > 0 }}" class="evil-lock-card">
          <view class="evil-lock-row">
            <view class="evil-lock-avatar">?</view>
            <view class="evil-lock-text">
              <view class="evil-lock-title">还有 {{ evilHiddenCount }} 位克星被隐藏</view>
              <view class="evil-lock-sub">看视频免费解锁 24 小时 · Pro 永久解锁</view>
            </view>
          </view>
          <view class="evil-lock-actions">
            <view class="evil-lock-btn evil-lock-btn-ad" bindtap="onWatchUnlockAd">📺 看视频解锁</view>
            <view class="evil-lock-btn evil-lock-btn-pro" bindtap="onGoUpgrade">升级 Pro</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 没玩家 -->
    <view wx:if="{{ players.length === 0 }}" class="empty-state">
      <view class="empty-illustration"><text class="empty-emoji">👥</text></view>
      <text class="empty-title">还没有玩家</text>
      <text class="empty-subtitle">先去首页添加玩家并记录战绩吧</text>
    </view>

    <!-- 广告：仅免费用户（Pro 免广告），福星克星 Tab 底部 -->
    <ad wx:if="{{ showFortuneAd }}" unit-id="{{ bannerUnitId }}" class="ad-banner"></ad>
  </view>

  <!-- ============ 牌局月历 Tab ============ -->
  <!-- 独立 wx:if（前面 wx:if 是 fortune 的；用 wx:else 会和它配对，导致 report Tab 选中也走 else）-->
  <view wx:if="{{ activeTab === 'calendar' }}" class="calendar-tab">

    <!-- 月份导航 -->
    <view class="month-nav section-card">
      <view class="month-arrow" bindtap="onPrevMonth">
        <text>‹</text>
      </view>
      <view class="month-text">{{ monthText }}</view>
      <view class="month-arrow" bindtap="onNextMonth">
        <text>›</text>
      </view>
    </view>

    <!-- 月度统计 -->
    <view wx:if="{{ calendarStats }}" class="month-stats">
      <view class="month-stat stat-win">
        <view class="month-stat-num">{{ calendarStats.winDays }}</view>
        <view class="month-stat-label">赢日</view>
      </view>
      <view class="month-stat stat-even">
        <view class="month-stat-num">{{ calendarStats.evenDays }}</view>
        <view class="month-stat-label">平日</view>
      </view>
      <view class="month-stat stat-lose">
        <view class="month-stat-num">{{ calendarStats.loseDays }}</view>
        <view class="month-stat-label">输日</view>
      </view>
      <view class="month-stat stat-total">
        <view class="month-stat-num">{{ calendarStats.totalGames }}</view>
        <view class="month-stat-label">总场次</view>
      </view>
    </view>

    <!-- 日历 -->
    <view class="calendar section-card">
      <view class="weekday-row">
        <view wx:for="{{ weekdays }}" wx:key="*this" class="weekday-cell">{{ item }}</view>
      </view>
      <view class="day-grid">
        <view wx:for="{{ calendarCells }}" wx:key="date"
              class="day-cell {{ !item.day ? 'day-empty' : '' }} {{ item.data && item.data.result === 'win' ? 'day-win' : '' }} {{ item.data && item.data.result === 'lose' ? 'day-lose' : '' }} {{ item.data && item.data.result === 'even' ? 'day-even' : '' }} {{ item.day && !item.data ? 'day-none' : '' }}"
              data-date="{{ item.date }}"
              bindtap="onDaySelect">
          <view wx:if="{{ item.day }}" class="day-num">{{ item.day }}</view>
          <view wx:if="{{ item.lunarLabel }}"
                class="day-lunar {{ item.lunarHighlight ? 'day-lunar-hl' : '' }}">{{ item.lunarLabel }}</view>
          <view wx:if="{{ item.data }}" class="day-score">
            {{ item.data.netScore > 0 ? '+' : '' }}{{ item.data.netScore }}
          </view>
        </view>
      </view>
    </view>

    <!-- 图例 -->
    <view class="legend">
      <view class="legend-item"><view class="legend-dot dot-win"></view>赢日</view>
      <view class="legend-item"><view class="legend-dot dot-even"></view>平日</view>
      <view class="legend-item"><view class="legend-dot dot-lose"></view>输日</view>
      <view class="legend-item"><view class="legend-dot dot-none"></view>未打</view>
    </view>

    <!-- 本月宜忌：借黄历的视觉语言，但内容 100% 来自本人历史战绩统计（非预测） -->
    <view wx:if="{{ advice && (advice.good.length > 0 || advice.bad.length > 0) }}"
          class="section-card advice-card">
      <view class="section-header">
        <view class="section-icon-wrap section-icon-advice">📜</view>
        <view class="section-title-wrap">
          <text class="section-title">本月宜忌</text>
          <text class="section-sub">依据你近 {{ advice.sampleGames }} 局战绩统计</text>
        </view>
      </view>

      <view class="advice-grid">
        <view class="advice-col advice-col-good">
          <view class="advice-seal advice-seal-good">宜</view>
          <view wx:for="{{ advice.good }}" wx:key="label" class="advice-item">
            <view class="advice-label">{{ item.label }}</view>
            <view class="advice-detail">{{ item.detail }}</view>
          </view>
          <view wx:if="{{ advice.good.length === 0 }}" class="advice-none">暂无可推荐</view>
        </view>

        <view class="advice-col advice-col-bad">
          <view class="advice-seal advice-seal-bad">忌</view>
          <view wx:for="{{ advice.bad }}" wx:key="label" class="advice-item">
            <view class="advice-label">{{ item.label }}</view>
            <view class="advice-detail">{{ item.detail }}</view>
          </view>
          <view wx:if="{{ advice.bad.length === 0 }}" class="advice-none">暂无要避开</view>
        </view>
      </view>

      <view class="advice-disclaimer">只统计已发生的战绩，不做任何预测</view>
    </view>

    <!-- 选中日详情 -->
    <view wx:if="{{ selectedDay }}" class="section-card day-detail">
      <view class="detail-header">
        <view>
          <view class="detail-title">{{ selectedDay.date }}</view>
          <view class="detail-lunar">{{ selectedDayLunar }}</view>
        </view>
        <view class="detail-close" bindtap="onCloseDayDetail">
          <text>×</text>
        </view>
      </view>

      <view wx:if="{{ selectedDayRecords.length === 0 }}" class="empty-mini">
        当日无战绩
      </view>

      <view wx:for="{{ selectedDayRecords }}" wx:key="id" class="detail-record">
        <view class="detail-record-head">
          <view class="record-rule-tag">{{ item.ruleName }}</view>
          <view class="record-time">{{ item.timeText }}</view>
        </view>
        <view wx:for="{{ item.players }}" wx:for-item="player" wx:key="playerId"
              class="detail-player-row">
          <view class="avatar avatar-sm avatar-grad-{{ (index % 8) + 1 }}">
            {{ player.nickname[0] }}
          </view>
          <text class="detail-player-name">{{ player.nickname }}</text>
          <text class="detail-player-score {{ player.score > 0 ? 't-success' : (player.score < 0 ? 't-danger' : '') }}">
            {{ player.score > 0 ? '+' : '' }}{{ player.score }}
          </text>
        </view>
      </view>
    </view>

    <!-- 无战绩 -->
    <view wx:if="{{ totalGames === 0 }}" class="empty-state">
      <view class="empty-illustration"><text class="empty-emoji">📅</text></view>
      <text class="empty-title">还没有战绩</text>
      <text class="empty-subtitle">去首页记录你的第一场牌局吧</text>
    </view>

    <!-- 广告：仅免费用户（Pro 免广告），牌局月历 Tab 底部 -->
    <ad wx:if="{{ showCalendarAd }}" unit-id="{{ bannerUnitId }}" class="ad-banner"></ad>
  </view>

  <!-- ============ 月度战报 Tab（Pro 专属）============ -->
  <!-- 单独 wx:if，不能用 wx:elif（前面 wx:else 已闭合第一个 if/elif/else 链）-->
  <view wx:if="{{ activeTab === 'report' }}" class="report-tab">

    <!-- 免费用户：显示锁定卡（数据已算好但锁定不展示；teaser 馋一下） -->
    <view wx:if="{{ !isPro }}" class="pro-lock-card">
      <view class="pro-lock-icon">🔒</view>
      <view class="pro-lock-title">月度战报需解锁 Pro</view>
      <view wx:if="{{ monthlyReport }}" class="pro-lock-teaser">
        本月你已打了 <text class="pro-lock-teaser-num">{{ monthlyReport.totalGames }}</text> 场牌，
        战报和专属海报已就绪
      </view>
      <view class="pro-lock-sub">解锁后可查看：月度称号战报、黄金时段、方位手气、高光时刻，并生成专属月报海报</view>
      <view class="pro-lock-actions">
        <view class="pro-lock-btn" bindtap="onGoUpgrade">¥9.9 永久解锁</view>
      </view>
    </view>

    <!-- Pro 用户：显示完整月度战报 -->
    <block wx:else>
      <!-- 本月战报 -->
      <view wx:if="{{ monthlyReport }}" class="section-card">
        <view class="section-header">
          <view class="section-icon-wrap section-icon-report">📊</view>
          <view class="section-title-wrap">
            <text class="section-title">本月战报</text>
            <text class="section-sub">{{ monthlyReport.year }} 年 {{ monthlyReport.month }} 月</text>
          </view>
        </view>

        <!-- 月度称号横幅 -->
        <view class="rp-title-banner">
          <text class="rp-title-emoji">{{ monthlyReport.title.emoji }}</text>
          <view class="rp-title-text">
            <text class="rp-title-name">{{ monthlyReport.title.name }}</text>
            <text class="rp-title-desc">{{ monthlyReport.title.desc }}</text>
          </view>
        </view>

        <view class="report-grid">
          <view class="report-cell">
            <view class="report-cell-num">{{ monthlyReport.totalGames }}</view>
            <view class="report-cell-label">参战场次</view>
          </view>
          <view class="report-cell">
            <view class="report-cell-num t-{{ monthlyReport.netScore >= 0 ? 'success' : 'danger' }}">{{ monthlyReport.netScoreText }}</view>
            <view class="report-cell-label">净胜分</view>
          </view>
          <view class="report-cell">
            <view class="report-cell-num t-{{ monthlyReport.winRate >= 50 ? 'success' : 'danger' }}">{{ monthlyReport.winRateText }}</view>
            <view class="report-cell-label">胜率</view>
          </view>
        </view>
        <view class="report-meta">
          <view class="report-meta-row">
            <text class="report-meta-key">本月 MVP 牌友</text>
            <text class="report-meta-val">{{ monthlyReport.mvpNickname }} <text class="report-meta-sub">(同桌 {{ monthlyReport.mvpGames }} 次)</text></text>
          </view>
          <view class="report-meta-row">
            <text class="report-meta-key">最常玩法</text>
            <text class="report-meta-val">{{ monthlyReport.topRuleName }} <text class="report-meta-sub">({{ monthlyReport.topRuleCount }} 局)</text></text>
          </view>
          <view wx:if="{{ monthlyReport.mom }}" class="report-meta-row">
            <text class="report-meta-key">较上月</text>
            <view class="report-meta-val rp-mom">
              <text>净胜 </text>
              <text class="rp-mom-delta rp-{{ monthlyReport.mom.netDeltaClass }}">{{ monthlyReport.mom.netDeltaText }}</text>
              <text class="report-meta-sub"> · 胜率 </text>
              <text class="rp-mom-delta rp-{{ monthlyReport.mom.winRateDeltaClass }}">{{ monthlyReport.mom.winRateDeltaText }}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-mini">本月还没有战绩</view>

      <!-- 手气洞察：黄金时段 + 方位 -->
      <view wx:if="{{ monthlyReport }}" class="section-gap"></view>
      <view wx:if="{{ monthlyReport }}" class="section-card">
        <view class="section-header">
          <view class="section-icon-wrap section-icon-report">🔍</view>
          <view class="section-title-wrap">
            <text class="section-title">手气洞察</text>
            <text class="section-sub">基于本月真实战绩</text>
          </view>
        </view>
        <view class="rp-insight-label">⏰ 按时段</view>
        <view class="rp-insight-grid">
          <view wx:for="{{ monthlyReport.durations }}" wx:key="key"
                class="rp-insight-cell {{ item.isBest ? 'rp-best' : '' }}">
            <view class="rp-insight-net {{ item.tone === 'pos' ? 't-success' : item.tone === 'neg' ? 't-danger' : '' }}">{{ item.netScoreText }}</view>
            <view class="rp-insight-main">{{ item.label }}<text wx:if="{{ item.isBest }}" class="rp-best-tag">旺</text></view>
            <view class="rp-insight-sub">{{ item.games }} 场 · 胜率 {{ item.winRateText }}</view>
          </view>
        </view>
        <view class="rp-insight-label">🧭 按方位</view>
        <view class="rp-insight-grid">
          <view wx:for="{{ monthlyReport.seats }}" wx:key="key"
                class="rp-insight-cell {{ item.isBest ? 'rp-best' : '' }}">
            <view class="rp-insight-net {{ item.tone === 'pos' ? 't-success' : item.tone === 'neg' ? 't-danger' : '' }}">{{ item.netScoreText }}</view>
            <view class="rp-insight-main">坐{{ item.label }}<text wx:if="{{ item.isBest }}" class="rp-best-tag">旺</text></view>
            <view class="rp-insight-sub">{{ item.games }} 场</view>
          </view>
        </view>
      </view>

      <!-- 高光时刻 -->
      <view wx:if="{{ monthlyReport && (monthlyReport.bestWin || monthlyReport.streakText || monthlyReport.pain) }}" class="section-gap"></view>
      <view wx:if="{{ monthlyReport && (monthlyReport.bestWin || monthlyReport.streakText || monthlyReport.pain) }}" class="section-card">
        <view class="section-header">
          <view class="section-icon-wrap section-icon-trend">⚡</view>
          <view class="section-title-wrap">
            <text class="section-title">高光时刻</text>
            <text class="section-sub">本月的名场面</text>
          </view>
        </view>
        <view class="rp-hl-row" wx:if="{{ monthlyReport.bestWin }}">
          <text class="rp-hl-icon">💥</text>
          <view class="rp-hl-body">
            <view class="rp-hl-line">最大单局 <text class="rp-hl-strong t-success">{{ monthlyReport.bestWin.scoreText }}</text></view>
            <view class="rp-hl-sub">{{ monthlyReport.bestWin.dateText }} · 同桌 {{ monthlyReport.bestWin.partnersText }}</view>
          </view>
        </view>
        <view class="rp-hl-row" wx:if="{{ monthlyReport.streakText }}">
          <text class="rp-hl-icon">🔥</text>
          <view class="rp-hl-body">
            <view class="rp-hl-line"><text class="rp-hl-strong">{{ monthlyReport.streakText }}</text></view>
            <view class="rp-hl-sub">连续赢下最多的纪录</view>
          </view>
        </view>
        <view class="rp-hl-row" wx:if="{{ monthlyReport.pain }}">
          <text class="rp-hl-icon">🥶</text>
          <view class="rp-hl-body">
            <view class="rp-hl-line">最扎心对手 <text class="rp-hl-strong t-danger">{{ monthlyReport.pain.nickname }}</text> <text class="t-danger">{{ monthlyReport.pain.netScoreText }}</text></view>
            <view class="rp-hl-sub">同桌 {{ monthlyReport.pain.games }} 次 · 完整克星榜见「福星克星」</view>
          </view>
        </view>
      </view>

      <!-- 月报海报入口（Pro 专属） -->
      <view wx:if="{{ monthlyReport }}" class="section-gap"></view>
      <view wx:if="{{ monthlyReport }}" class="rp-poster-cta" bindtap="onOpenReportPoster">
        <text class="rp-poster-cta-icon">🖼️</text>
        <view class="rp-poster-cta-text">
          <text class="rp-poster-cta-title">生成月度战报海报</text>
          <text class="rp-poster-cta-sub">称号 + 战绩一图流，保存分享到牌友群</text>
        </view>
        <text class="rp-poster-cta-arrow">›</text>
      </view>

      <!-- 最近 6 月趋势 -->
      <view class="section-gap"></view>
      <view wx:if="{{ monthlyTrend.length > 0 }}" class="section-card">
        <view class="section-header">
          <view class="section-icon-wrap section-icon-trend">📈</view>
          <view class="section-title-wrap">
            <text class="section-title">最近 6 月场次趋势</text>
            <text class="section-sub">{{ monthlyTrend[monthlyTrend.length - 1].yearMonth }} 当月</text>
          </view>
        </view>
        <view class="trend-bars">
          <view wx:for="{{ monthlyTrend }}" wx:key="yearMonth"
                class="trend-bar-wrap {{ item.isCurrent ? 'trend-bar-current' : '' }}">
            <view class="trend-bar-num">{{ item.count }}</view>
            <view class="trend-bar-track">
              <view class="trend-bar-fill" style="height: {{ item.count > 0 ? (item.count * 100 / item.max) : 0 }}%;"></view>
            </view>
            <view class="trend-bar-label">
              {{ item.label }}
              <text wx:if="{{ item.netScore !== 0 }}" class="trend-bar-net {{ item.netScore > 0 ? 't-success' : 't-danger' }}">
                {{ item.netScore > 0 ? '+' : '' }}{{ item.netScore }}
              </text>
            </view>
          </view>
        </view>
      </view>

      <!-- 合规脚注：全部为历史战绩统计，非预测 -->
      <view wx:if="{{ monthlyReport }}" class="rp-compliance">{{ monthlyReport.complianceText }}</view>
    </block>

    <!-- 广告：仅免费用户（Pro 免广告），月度战报 Tab 底部（免费用户在锁定卡下方） -->
    <ad wx:if="{{ showReportAd }}" unit-id="{{ bannerUnitId }}" class="ad-banner"></ad>
  </view>

</view>
<!-- 登录抽屉（未登录时由 utils/auth 弹出；登录成功回调刷新页面数据） -->
<login-drawer id="loginDrawer" bind:loggedin="onLoggedIn" />
