/* pages/analysis/analysis.wxss — 精修版 */

.page {
  padding: 0 0 160rpx 0;
  min-height: 100vh;
}

/* ===== 通用 section 卡片 ===== */
.section-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
}

.section-gap { height: 8rpx; }

/* ===== Tab pill ===== */
.tab-pill {
  display: flex;
  margin: 24rpx 24rpx 24rpx;
  padding: 6rpx;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  box-shadow: var(--shadow-md);
}

.tab-pill-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  border-radius: 26rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  transition: all 0.2s ease;
}

.tab-pill-active {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(74, 157, 126, 0.3);
}

.tab-pill-emoji {
  font-size: 24rpx;
}

/* ===== 总览卡 =====
   与福星克星共用同一份值（累计场次 / 牌友数 / 相关场次），
   只是上下文提示，不可点击 → 压缩视觉权重，把版面让给月历与宜忌。 */
.overview-card {
  padding: 18rpx 28rpx;
  margin-bottom: 20rpx;
}

.overview-row {
  display: flex;
  align-items: center;
}

.overview-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.overview-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
  font-feature-settings: 'tnum';
  letter-spacing: -0.5rpx;
}

.overview-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.overview-divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--color-border);
}

/* ===== 玩家选择 ===== */
.player-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.player-picker-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 2rpx;
}

.picker-sub {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
}

.picker-arrow {
  color: var(--color-text-tertiary);
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

/* ===== Section 标题 ===== */
.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.section-icon-lucky {
  background: linear-gradient(135deg, #FAEEDA 0%, #FAC775 100%);
}

.section-icon-evil {
  background: linear-gradient(135deg, #FCEBEB 0%, #F09595 100%);
}

.section-icon-advice {
  background: linear-gradient(135deg, var(--color-bg-surface) 0%, #D3D1C7 100%);
}

.section-title-wrap {
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.3rpx;
}

.section-sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 2rpx;
}

/* ===== 福星克星列表 ===== */
.fortune-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fortune-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  border: 1rpx solid var(--color-border);
  transition: all 0.15s ease;
  position: relative;
  overflow: hidden;
}

.fortune-row:active {
  transform: scale(0.99);
}

.fortune-lucky {
  background: linear-gradient(135deg, #F1FAF6 0%, #FFFFFF 60%);
  border-color: rgba(29, 158, 117, 0.18);
}

.fortune-lucky::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #1D9E75 0%, #5DCAA5 100%);
}

.fortune-evil {
  background: linear-gradient(135deg, #FEF5F5 0%, #FFFFFF 60%);
  border-color: rgba(226, 75, 74, 0.18);
}

.fortune-evil::before {
  content: '';
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #E24B4A 0%, #F09595 100%);
}

.fortune-rank {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  background: var(--color-bg-surface);
  color: var(--color-text-secondary);
  border-radius: 50%;
  flex-shrink: 0;
}

.rank-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFB300 100%);
  color: #5F4500;
  font-size: 28rpx;
}

.rank-2 {
  background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%);
  color: #424242;
}

.rank-3 {
  background: linear-gradient(135deg, #CD7F32 0%, #B8732B 100%);
  color: #fff;
}

.fortune-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.fortune-nick {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.3rpx;
}

.fortune-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: var(--color-bg-surface);
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.meta-tag-success {
  background: var(--color-success-tint);
  color: var(--color-success);
}

.meta-tag-danger {
  background: var(--color-danger-tint);
  color: var(--color-danger);
}

.fortune-score-wrap {
  text-align: right;
  flex-shrink: 0;
}

.fortune-score {
  font-size: 32rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  letter-spacing: -0.5rpx;
}

.fortune-score-label {
  font-size: 18rpx;
  color: var(--color-text-tertiary);
  margin-top: 2rpx;
}

/* ===== 月历 ===== */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-bg-surface);
  font-size: 40rpx;
  color: var(--color-primary);
  font-weight: 300;
  transition: all 0.15s ease;
}

.month-arrow:active {
  background: var(--color-primary-soft);
  transform: scale(0.92);
}

.month-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.5rpx;
}

/* 月度统计 */
.month-stats {
  display: flex;
  margin: 0 24rpx 24rpx;
  gap: 12rpx;
}

.month-stat {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
  overflow: hidden;
}

.stat-win::before, .stat-even::before, .stat-lose::before, .stat-total::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4rpx;
}

.stat-win::before { background: linear-gradient(90deg, #1D9E75 0%, #5DCAA5 100%); }
.stat-even::before { background: linear-gradient(90deg, #9B9A93 0%, #C4C2B9 100%); }
.stat-lose::before { background: linear-gradient(90deg, #E24B4A 0%, #F09595 100%); }
.stat-total::before { background: linear-gradient(90deg, #4A9D7E 0%, #84C9AB 100%); }

.month-stat-num {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  font-feature-settings: 'tnum';
}

.month-stat-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.stat-win .month-stat-num { color: var(--color-success); }
.stat-lose .month-stat-num { color: var(--color-danger); }
.stat-total .month-stat-num { color: var(--color-primary); }

/* ===== 日历 ===== */
.calendar {
  padding: 20rpx 16rpx 24rpx;
}

.weekday-row {
  display: flex;
  padding: 8rpx 0 16rpx;
  border-bottom: 1rpx solid var(--color-border);
  margin-bottom: 16rpx;
}

.weekday-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.day-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.day-cell {
  width: calc((100% - 6 * 8rpx) / 7);
  /* 原来是 aspect-ratio: 1，加农历行后要容纳「日期 + 农历 + 分数」三行，改为固定最小高度 */
  min-height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 4rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--color-text);
  transition: all 0.15s ease;
  position: relative;
}

.day-cell:active {
  transform: scale(0.92);
}

.day-empty {
  background: transparent;
  pointer-events: none;
}

.day-none {
  background: var(--color-bg-surface);
  opacity: 0.55;
}

.day-even {
  background: var(--color-bg-surface);
}

.day-win {
  background: linear-gradient(135deg, var(--color-success-soft) 0%, var(--color-success-tint) 100%);
  color: var(--color-success);
  font-weight: 600;
}

.day-lose {
  background: linear-gradient(135deg, var(--color-danger-soft) 0%, var(--color-danger-tint) 100%);
  color: var(--color-danger);
  font-weight: 600;
}

.day-num {
  font-size: 24rpx;
  line-height: 1.2;
}

/* 农历/节气/节日短标签（历法信息，与吉凶无关） */
.day-lunar {
  font-size: 16rpx;
  line-height: 1.25;
  margin-top: 2rpx;
  color: var(--color-text-tertiary);
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
}

/* 传统节日 / 节气：按历法惯例标红 */
.day-lunar-hl {
  color: var(--color-danger);
  font-weight: 500;
}

.day-score {
  font-size: 18rpx;
  font-weight: 600;
  margin-top: 2rpx;
  font-feature-settings: 'tnum';
}

/* 图例 */
.legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  padding: 8rpx 16rpx 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
}

.dot-win { background: linear-gradient(135deg, var(--color-success-soft) 0%, var(--color-success-tint) 100%); border: 1rpx solid var(--color-success); }
.dot-lose { background: linear-gradient(135deg, var(--color-danger-soft) 0%, var(--color-danger-tint) 100%); border: 1rpx solid var(--color-danger); }
.dot-even { background: var(--color-bg-surface); border: 1rpx solid var(--color-text-quaternary); }
.dot-none { background: var(--color-bg-surface); border: 1rpx solid var(--color-text-quaternary); opacity: 0.5; }

/* ===== 选中日详情 ===== */
.day-detail {
  margin-top: 8rpx;
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

/* 选中日的农历全称，如「八月十五 · 中秋节」 */
.detail-lunar {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.detail-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-bg-surface);
  color: var(--color-text-tertiary);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 300;
}

.detail-close:active {
  background: var(--color-border-strong);
  transform: scale(0.92);
}

.detail-record {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--color-border);
}

.detail-record:first-of-type {
  border-top: 0;
}

.detail-record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.record-rule-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-size: 22rpx;
  font-weight: 500;
}

.record-time {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.detail-player-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.detail-player-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text);
}

.detail-player-score {
  font-size: 28rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
}

/* ===== 空状态 ===== */
.empty-mini {
  text-align: center;
  padding: 32rpx 16rpx;
  color: var(--color-text-tertiary);
  font-size: 24rpx;
  background: var(--color-bg-surface);
  border-radius: 16rpx;
  line-height: 1.5;
}

.empty-tip {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
  opacity: 0.8;
}
/* ===== 克星榜锁定态（免费版） ===== */
.evil-lock-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(163, 45, 45, 0.05);
  border: 1rpx dashed rgba(163, 45, 45, 0.35);
}

.evil-lock-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.evil-lock-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F1EFE8;
  color: #888780;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.evil-lock-text {
  flex: 1;
}

.evil-lock-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #A32D2D;
}

.evil-lock-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9B9A93;
}

.evil-lock-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.evil-lock-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.evil-lock-btn:active {
  transform: scale(0.97);
}

.evil-lock-btn-ad {
  background: #FAEEDA;
  color: #854F0B;
}

.evil-lock-btn-pro {
  background: #4A9D7E;
  color: #fff;
}

/* ===== 本月宜忌卡片 =====
   借黄历的「宜/忌」视觉语言（朱红印章式双栏），但内容来自本人历史战绩统计。
   合规说明见 utils/advice.ts 顶部——这里只呈现已发生的事实，不做预测。
   位置：紧贴日历 + 图例下方（比月度统计更靠近用户视线中心）。 */
.advice-card {
  margin-top: 4rpx;
}

.advice-grid {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.advice-col {
  flex: 1;
  min-width: 0;
  border-radius: var(--radius-lg);
  padding: 20rpx 20rpx 24rpx;
  position: relative;
}

.advice-col-good {
  background: var(--color-danger-soft);
}

.advice-col-bad {
  background: var(--color-bg-surface);
}

/* 印章式标签 */
.advice-seal {
  display: inline-block;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.advice-seal-good {
  background: var(--color-danger);
}

.advice-seal-bad {
  background: #444441;
}

.advice-item + .advice-item {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(31, 30, 27, 0.06);
}

.advice-label {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.advice-col-good .advice-label {
  color: #501313;
}

.advice-col-bad .advice-label {
  color: #2C2C2A;
}

.advice-detail {
  font-size: 20rpx;
  line-height: 1.5;
  margin-top: 4rpx;
  font-feature-settings: 'tnum';
}

.advice-col-good .advice-detail {
  color: #993C1D;
}

.advice-col-bad .advice-detail {
  color: #888780;
}

.advice-none {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.advice-disclaimer {
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-quaternary);
}
