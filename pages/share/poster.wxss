/* pages/share/poster.wxss — 精修版 */

.page {
  padding: 0 0 160rpx 0;
  min-height: 100vh;
  background: var(--color-bg);
}

/* ===== 顶部紫色 Hero 区 ===== */
.poster-hero {
  position: relative;
  padding: 48rpx 32rpx 64rpx;
  overflow: hidden;
}

.poster-hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #4A9D7E 0%, #5BAA89 50%, #84C9AB 100%);
}

.poster-hero-bg::before {
  content: '';
  position: absolute;
  top: -100rpx; right: -100rpx;
  width: 320rpx; height: 320rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
  border-radius: 50%;
}

.poster-hero-bg::after {
  content: '';
  position: absolute;
  bottom: 40rpx; left: -60rpx;
  width: 220rpx; height: 220rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.poster-hero-content {
  position: relative;
  z-index: 1;
  color: #fff;
  text-align: center;
}

.poster-brand {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  font-size: 22rpx;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.poster-rule {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  margin-bottom: 8rpx;
}

.poster-meta {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.poster-meta-divider {
  width: 4rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
}

/* ===== 主卡片 ===== */
.share-card {
  margin: -32rpx 24rpx 0;
  background: var(--color-bg-card);
  border-radius: 28rpx;
  padding: 32rpx 32rpx 28rpx;
  box-shadow: var(--shadow-lg);
  position: relative;
  z-index: 2;
}

/* 头部品牌 + 日期 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--color-border);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.brand-emoji {
  font-size: 32rpx;
}

.brand-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 0.5rpx;
}

.brand-tag {
  padding: 4rpx 10rpx;
  background: var(--color-primary-tint);
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 8rpx;
}

.date-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* 排名 */
.rank-section {
  padding: 24rpx 0 8rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.rank-row:first-child {
  background: linear-gradient(135deg, #FAEEDA 0%, #FFF3DA 100%);
  border: 1rpx solid rgba(186, 117, 23, 0.15);
}

.rank-medal {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: var(--color-bg-surface);
  border-radius: 50%;
}

.rank-medal-1 {
  background: linear-gradient(135deg, #FFD700 0%, #FFB300 100%);
  font-size: 32rpx;
}

.rank-medal-2 {
  background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%);
  font-size: 32rpx;
}

.rank-medal-3 {
  background: linear-gradient(135deg, #CD7F32 0%, #B8732B 100%);
  font-size: 32rpx;
  color: #fff;
}

.rank-nick {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.3rpx;
}

.rank-score {
  font-size: 32rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  letter-spacing: -0.5rpx;
}

.score-pos { color: var(--color-success); }
.score-neg { color: var(--color-danger); }

/* 亮点 */
.highlights {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--color-border);
}

.highlight-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx 12rpx;
  background: var(--color-bg-surface);
  border-radius: 14rpx;
  align-items: center;
}

.highlight-emoji {
  font-size: 24rpx;
  margin-bottom: 2rpx;
}

.highlight-label {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

.highlight-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  font-feature-settings: 'tnum';
}

/* 备注 */
.card-note {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: var(--color-warning-soft);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
  border-left: 4rpx solid var(--color-warning);
}

.note-icon {
  margin-right: 8rpx;
}

/* 底部 */
.card-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--color-border);
  text-align: center;
}

.footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.footer-label {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.footer-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.footer-cta {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

/* ===== 操作栏 ===== */
.action-bar {
  margin: 32rpx 24rpx 0;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  background: var(--color-bg-card);
  color: var(--color-text);
  box-shadow: var(--shadow-md);
  letter-spacing: 0.3rpx;
}

.action-btn:active {
  transform: scale(0.98);
}

.btn-share {
  background: var(--color-primary) !important;
  color: #fff;
  box-shadow: var(--shadow-primary) !important;
}

.btn-timeline {
  background: var(--color-success) !important;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(29, 158, 117, 0.25) !important;
}

.btn-icon {
  font-size: 30rpx;
  line-height: 1;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 32rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 24rpx;
}

/* 屏外 canvas：用于生成海报，避免在页面显示但参与离屏渲染 */
.canvas-off-screen {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 750px;
  height: 1200px;
}