<!-- pages/share/poster.wxml -->
<view class="page">

  <!-- 拉新引导页：转发卡片在别人手机上打开（本地无此战绩） -->
  <block wx:if="{{ guestMode }}">
    <view class="poster-hero">
      <view class="poster-hero-bg"></view>
      <view class="poster-hero-content">
        <view class="poster-brand">🀄 雀战录</view>
        <view class="poster-rule">记录每一场牌局</view>
        <view class="poster-meta">
          <text>战绩排行 · 福星克星 · 牌局月历</text>
        </view>
      </view>
    </view>

    <view class="guest-card">
      <view class="guest-title">你的牌友在用「雀战录」记战绩</view>
      <view class="guest-sub">打完牌顺手记一笔，谁赢谁输一目了然</view>
      <view class="guest-points">
        <view class="guest-point"><text class="guest-point-icon">📋</text><text>记分简单，自动算账</text></view>
        <view class="guest-point"><text class="guest-point-icon">📊</text><text>胜率 / 克星 / 月历复盘</text></view>
        <view class="guest-point"><text class="guest-point-icon">🀄</text><text>免费使用，本地保存</text></view>
      </view>
      <button class="guest-btn" bindtap="onStartUsing">开始记录战绩</button>
    </view>
  </block>

  <!-- 顶部 Hero -->
  <block wx:if="{{ record }}">
    <view class="poster-hero">
      <view class="poster-hero-bg"></view>
      <view class="poster-hero-content">
        <view class="poster-brand">🀄 雀战录 · 战绩分享</view>
        <view class="poster-rule">{{ record.ruleName }}</view>
        <view class="poster-meta">
          <text>{{ playedAtText }}</text>
          <view class="poster-meta-divider"></view>
          <text>{{ durationLabel }}</text>
          <text wx:if="{{ record.mood }}">{{ record.mood }}</text>
        </view>
      </view>
    </view>

    <!-- 主卡片 -->
    <view class="share-card">
      <view class="card-head">
        <view class="brand-row">
          <text class="brand-emoji">🀄</text>
          <text class="brand-name">雀战录</text>
          <text class="brand-tag">{{ ruleLabel }}</text>
        </view>
        <text class="date-text">{{ playedAtText }}</text>
      </view>

      <!-- 玩家排名 -->
      <view class="rank-section">
        <view wx:for="{{ rankedPlayers }}" wx:key="nickname"
              class="rank-row">
          <view class="rank-medal {{ item.rank === 1 ? 'rank-medal-1' : '' }} {{ item.rank === 2 ? 'rank-medal-2' : '' }} {{ item.rank === 3 ? 'rank-medal-3' : '' }}">
            {{ item.medal }}
          </view>
          <view class="rank-nick">{{ item.nickname }}</view>
          <view class="rank-score {{ item.score > 0 ? 'score-pos' : 'score-neg' }}">
            {{ item.score > 0 ? '+' : '' }}{{ item.score }}
          </view>
        </view>
      </view>

      <!-- 亮点 -->
      <view wx:if="{{ highest && lowest }}" class="highlights">
        <view class="highlight-item">
          <text class="highlight-emoji">🏆</text>
          <text class="highlight-label">MVP</text>
          <text class="highlight-value">{{ highest.nickname }} +{{ highest.score }}</text>
        </view>
        <view class="highlight-item">
          <text class="highlight-emoji">💧</text>
          <text class="highlight-label">最低分</text>
          <text class="highlight-value">{{ lowest.nickname }} {{ lowest.score }}</text>
        </view>
        <view class="highlight-item">
          <text class="highlight-emoji">⚡</text>
          <text class="highlight-label">分差</text>
          <text class="highlight-value">{{ scoreGap }}</text>
        </view>
      </view>

      <!-- 备注 -->
      <view wx:if="{{ record.note }}" class="card-note">
        <text class="note-icon">📝</text>
        <text>{{ record.note }}</text>
      </view>

      <!-- 底部品牌 -->
      <view class="card-footer">
        <view class="footer-row">
          <text class="footer-label">累计战绩</text>
          <text class="footer-value">{{ totalGames }} 场</text>
        </view>
        <view class="footer-cta">
          <text>由雀战录生成 · 扫码进小程序</text>
        </view>
      </view>
    </view>

    <!-- 免费用户：Pro 升级引导横幅 -->
    <view wx:if="{{ !isPro }}" class="pro-cta" bindtap="onTapProCta">
      <view class="pro-cta-icon">✨</view>
      <view class="pro-cta-text">
        <text class="pro-cta-title">升级 Pro · 深度复盘</text>
        <text class="pro-cta-sub">月度战报 · 克星榜全量 · 云端全量备份</text>
      </view>
      <text class="pro-cta-arrow">›</text>
    </view>

    <!-- Pro 用户：已解锁提示 -->
    <view wx:if="{{ isPro }}" class="pro-active">
      <text class="pro-active-icon">✓</text>
      <text class="pro-active-text">Pro 已解锁 · 月度战报 / 克星榜全量 / 云端备份</text>
    </view>

    <!-- 操作栏：保存图片为主（拉新主通道），转发好友为次；朋友圈走右上角菜单 -->
    <view class="action-bar">
      <button class="action-btn btn-save" bindtap="onSaveImage" disabled="{{ saving }}">
        <text class="btn-icon">{{ saving ? '⏳' : '📷' }}</text>
        <text>{{ saving ? '生成中…' : '保存战绩图' }}</text>
      </button>
      <button class="action-btn btn-share" open-type="share">
        <text class="btn-icon">💬</text>
        <text>转发</text>
      </button>
    </view>
  </block>

  <!-- 屏外 canvas：用于生成海报（不显示但参与渲染；缓冲区尺寸在 TS 里设置） -->
  <canvas type="2d" id="poster-canvas" class="canvas-off-screen"></canvas>
</view>
