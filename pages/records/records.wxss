/* pages/records/records.wxss — 精修版 */

.page {
  padding: 0 0 160rpx 0;
  min-height: 100vh;
}

/* ===== 通用 section 卡片 ===== */
.section-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-bar {
  width: 6rpx;
  height: 24rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ===== 总览 Hero ===== */
.overview-hero {
  position: relative;
  margin: 24rpx 24rpx 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.overview-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #4A9D7E 0%, #5BAA89 50%, #84C9AB 100%);
}

.overview-bg::before {
  content: '';
  position: absolute;
  top: -60rpx; right: -60rpx;
  width: 240rpx; height: 240rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
  border-radius: 50%;
}

.overview-bg::after {
  content: '';
  position: absolute;
  bottom: 20rpx; left: -40rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.overview-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 28rpx;
  color: #fff;
}

.overview-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.overview-stat-main {
  flex: 1;
}

.overview-num {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -2rpx;
  font-feature-settings: 'tnum';
}

.overview-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.overview-mood {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.mood-emoji-large {
  font-size: 48rpx;
  line-height: 1;
}

.overview-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20rpx);
  border-radius: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.ov-stat {
  flex: 1;
  text-align: center;
}

.ov-stat-num {
  font-size: 32rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  letter-spacing: -0.5rpx;
}

.ov-stat-label {
  font-size: 20rpx;
  opacity: 0.85;
  margin-top: 2rpx;
}

.ov-divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* ===== 玩法分布 ===== */
.rule-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280rpx, 1fr));
  gap: 16rpx;
}

.rule-card {
  display: flex;
  background: var(--color-bg-surface);
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
}

.rule-card-bar {
  width: 6rpx;
  flex-shrink: 0;
}

.rule-card-content {
  flex: 1;
  padding: 20rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rule-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.rule-card-games {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.rule-card-rate {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.rate-bar-bg {
  flex: 1;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.06);
  border-radius: 4rpx;
  overflow: hidden;
}

.rate-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.rate-text {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--color-text);
  font-feature-settings: 'tnum';
}

/* ===== 筛选 ===== */
/* 牌友过滤提示条（来自 query 参数：?nickname=老张） */
.nickname-filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(74, 157, 126, 0.08);
  border: 1rpx solid rgba(74, 157, 126, 0.25);
  border-radius: 16rpx;
}

.nickname-filter-icon {
  font-size: 28rpx;
}

.nickname-filter-text {
  flex: 1;
  font-size: 26rpx;
  color: #4A9D7E;
  font-weight: 500;
}

.nickname-filter-clear {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 32rpx;
  color: #4A9D7E;
  font-weight: 300;
}

.nickname-filter-clear:active {
  opacity: 0.5;
}

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 20rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

.filter-arrow {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 300;
}

.filter-info {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-feature-settings: 'tnum';
}

/* ===== 战绩列表 ===== */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx;
}

.record-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-md);
  overflow: hidden;
  display: flex;
  transition: all 0.15s ease;
  position: relative;
}

.record-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-sm);
}

.record-bar {
  width: 6rpx;
  flex-shrink: 0;
}

.record-bar-win {
  background: linear-gradient(180deg, #1D9E75 0%, #5DCAA5 100%);
}

.record-bar-lose {
  background: linear-gradient(180deg, #E24B4A 0%, #F09595 100%);
}

.record-bar-even {
  background: linear-gradient(180deg, #9B9A93 0%, #C4C2B9 100%);
}

.record-content {
  flex: 1;
  padding: 24rpx 24rpx 20rpx;
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.rule-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.mood-emoji-mini {
  font-size: 32rpx;
  line-height: 1;
}

.record-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 16rpx;
}

.record-players {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.player-rank {
  width: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
}

.player-rank-top {
  font-size: 24rpx;
}

.player-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.player-score {
  font-size: 28rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  letter-spacing: -0.5rpx;
}

.record-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--color-bg-surface);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.note-icon {
  flex-shrink: 0;
}

.note-text {
  flex: 1;
}

.record-footer {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border);
  text-align: right;
}

.footer-action {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-tint) 0%, var(--color-primary-soft) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

.empty-illustration::before {
  content: '';
  position: absolute;
  inset: -16rpx;
  border-radius: 50%;
  border: 1rpx dashed var(--color-primary);
  opacity: 0.3;
}

.empty-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 32rpx;
}

.empty-cta {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 40rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: var(--shadow-primary);
}

.empty-cta:active {
  transform: scale(0.97);
}

.cta-arrow {
  font-size: 28rpx;
  line-height: 1;
}
/* ===== 广告（仅免费用户） ===== */
.ad-banner {
  margin: 24rpx 24rpx 40rpx;
}
