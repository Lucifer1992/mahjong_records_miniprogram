<!-- pages/records/records.wxml -->
<view class="page">

  <!-- 总览 Hero -->
  <view class="overview-hero">
    <view class="overview-bg"></view>
    <view class="overview-content">
      <view class="overview-top">
        <view class="overview-stat-main">
          <view class="overview-num">{{ overall.totalGames }}</view>
          <view class="overview-label">累计场次</view>
        </view>
        <view class="overview-mood" wx:if="{{ overall.totalGames > 0 }}">
          <text class="mood-emoji-large">🀄</text>
        </view>
      </view>
      <view class="overview-stats">
        <view class="ov-stat">
          <view class="ov-stat-num">{{ overall.winDays }}</view>
          <view class="ov-stat-label">活跃日</view>
        </view>
        <view class="ov-divider"></view>
        <view class="ov-stat">
          <view class="ov-stat-num">{{ overall.maxWinStreak }}</view>
          <view class="ov-stat-label">最长连胜</view>
        </view>
        <view class="ov-divider"></view>
        <view class="ov-stat">
          <view class="ov-stat-num">{{ overall.totalPlayers }}</view>
          <view class="ov-stat-label">牌友</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 玩法分布 -->
  <view wx:if="{{ ruleStats.length > 0 }}" class="rule-stats section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">玩法分布</text>
      </view>
      <text class="section-meta">{{ ruleStats.length }} 种</text>
    </view>
    <view class="rule-grid">
      <view wx:for="{{ ruleStats }}" wx:key="ruleType" class="rule-card">
        <view class="rule-card-bar" style="background: {{ item.color }};"></view>
        <view class="rule-card-content">
          <view class="rule-card-name">{{ item.ruleName }}</view>
          <view class="rule-card-games">{{ item.games }} 场</view>
          <view class="rule-card-rate">
            <view class="rate-bar-bg">
              <view class="rate-bar-fill" style="width: {{ item.winRatePercent }}%; background: {{ item.color }};"></view>
            </view>
            <text class="rate-text">胜率 {{ item.winRatePercent }}%</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 牌友过滤提示（从首页"查看该牌友历史"入口进来时显示） -->
  <view wx:if="{{ nicknameFilter }}" class="nickname-filter-bar">
    <text class="nickname-filter-icon">🎯</text>
    <text class="nickname-filter-text">只看「{{ nicknameFilter }}」的战绩</text>
    <view class="nickname-filter-clear" bindtap="onClearNicknameFilter">
      <text>×</text>
    </view>
  </view>

  <!-- 筛选 -->
  <view wx:if="{{ records.length > 0 }}" class="filter-bar">
    <picker mode="selector" range="{{ ruleFilterOptions }}" range-key="name"
            value="{{ selectedFilterIndex }}"
            bindchange="onRuleFilterChange">
      <view class="filter-pill">
        <text>{{ selectedFilterLabel }}</text>
        <text class="filter-arrow">⌄</text>
      </view>
    </picker>
    <view class="filter-info">{{ filteredRecords.length }} 场战绩</view>
  </view>

  <!-- 战绩列表 -->
  <view wx:if="{{ hasRecords }}" class="record-list">
    <view wx:for="{{ filteredRecords }}" wx:key="id"
          class="record-card"
          data-id="{{ item.id }}"
          bindtap="onRecordTap"
          bindlongpress="onRecordLongPress">
      <view class="record-bar record-bar-{{ item.bestResult }}"></view>
      <view class="record-content">
        <view class="record-header">
          <view class="rule-chip" style="background: {{ item.ruleColor }}20; color: {{ item.ruleColor }};">
            {{ item.ruleLabel }}
          </view>
          <view wx:if="{{ item.moodEmoji }}" class="mood-emoji-mini">{{ item.moodEmoji }}</view>
        </view>

        <view class="record-meta">
          <text>{{ item.playedAtText }} · {{ item.durationLabel }} · {{ item.playerCount }} 人</text>
        </view>

        <view class="record-players">
          <view wx:for="{{ item.topPlayers }}" wx:for-item="player" wx:key="rank"
                class="player-row">
            <view class="player-rank {{ player.rank <= 3 ? 'player-rank-top' : '' }}">
              <text wx:if="{{ player.rank === 1 }}">🥇</text>
              <text wx:elif="{{ player.rank === 2 }}">🥈</text>
              <text wx:elif="{{ player.rank === 3 }}">🥉</text>
              <text wx:else>{{ player.rank }}</text>
            </view>
            <view class="avatar avatar-sm avatar-grad-{{ (player.rank % 8) + 1 }}">
              {{ player.nickname[0] }}
            </view>
            <text class="player-name">{{ player.nickname }}</text>
            <text class="player-score {{ player.score > 0 ? 't-success' : (player.score < 0 ? 't-danger' : '') }}">
              {{ player.score > 0 ? '+' : '' }}{{ player.score }}
            </text>
          </view>
        </view>

        <view wx:if="{{ item.note }}" class="record-note">
          <text class="note-icon">📝</text>
          <text class="note-text">{{ item.note }}</text>
        </view>

        <view class="record-footer">
          <text class="footer-action">查看分享卡 ›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <view class="empty-illustration">
      <text class="empty-emoji">📜</text>
    </view>
    <text class="empty-title">还没有战绩</text>
    <text class="empty-subtitle">去首页记录你的第一场牌局吧</text>
    <view class="empty-cta" bindtap="onGoHome">
      <text>开始第一局</text>
      <text class="cta-arrow">›</text>
    </view>
  </view>

  <!-- 广告：仅免费用户（Pro 免广告）；后台未配置广告位 ID 时不渲染 -->
  <ad wx:if="{{ showAd }}" unit-id="{{ adUnitId }}" class="ad-banner"></ad>

</view>
<!-- 登录抽屉（未登录时由 utils/auth 弹出；登录成功回调刷新页面数据） -->
<login-drawer id="loginDrawer" bind:loggedin="onLoggedIn" />
