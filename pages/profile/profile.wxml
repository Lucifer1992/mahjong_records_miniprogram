<!-- pages/profile/profile.wxml -->
<view class="page">

  <!-- 用户 Hero -->
  <view class="user-hero">
    <view class="user-hero-bg"></view>
    <view class="user-hero-content" bindtap="onUserHeroTap">
      <view class="user-avatar">
        <!-- 已登录：点头像拉起换头像面板（内置 20 头像 / 微信头像）
             ⚠️ 同节点只能绑一个 tap：bindtap+catchtap 双绑时 catchtap 优先、bindtap 被忽略
             （2026-10-03 实锤：双绑导致 onAvatarTap 永远不执行，点击无反应无报错） -->
        <button wx:if="{{ isLoggedIn }}" class="avatar-change-btn"
                catchtap="onAvatarTap">
          <image wx:if="{{ accountAvatar }}" class="avatar-img" src="{{ accountAvatar }}" mode="aspectFill" />
          <text wx:else class="avatar-emoji">🀄</text>
        </button>
        <text wx:else class="avatar-emoji">👤</text>
      </view>
      <view class="user-info">
        <view class="user-name-row">
          <view class="user-name">{{ accountName || (isLoggedIn ? '雀战录用户' : '未登录') }}</view>
          <text wx:if="{{ isLoggedIn }}" class="user-name-edit" catchtap="onEditNickname">✏️</text>
        </view>
        <view class="user-meta">
          <text wx:if="{{ isLoggedIn }}">{{ totalGames }} 场战绩 · {{ totalPlayers }} 位牌友</text>
          <text wx:else>点此登录，战绩自动存云端</text>
        </view>
      </view>
      <view class="user-badge">
        <text wx:if="{{ isLoggedIn }}">LV.</text>
        <text wx:if="{{ isLoggedIn }}" class="user-level">{{ userLevel }}</text>
        <text wx:else class="user-action-text">登录 ›</text>
      </view>
    </view>
  </view>

  <!-- 核心统计 -->
  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-num t-primary">{{ totalGames }}</view>
      <view class="stat-label">累计场次</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-card">
      <view class="stat-num t-success">{{ totalPlayers }}</view>
      <view class="stat-label">牌友数</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-card">
      <view class="stat-num t-warning">{{ winRate }}%</view>
      <view class="stat-label">总胜率</view>
    </view>
  </view>

  <!-- 同步状态 -->
  <view class="sync-bar">
    <view class="sync-dot sync-{{ syncStatus }}"></view>
    <view class="sync-text-wrap">
      <block wx:if="{{ syncStatus === 'syncing' }}">
        <text class="sync-text-main">正在备份...</text>
        <text class="sync-text-sub">把手机里的战绩存到云端</text>
      </block>
      <block wx:elif="{{ syncStatus === 'error' }}">
        <text class="sync-text-main">上次备份失败</text>
        <text class="sync-text-sub">战绩已存在手机里，联网后会自动再试</text>
      </block>
      <block wx:elif="{{ syncStatus === 'pending' }}">
        <text class="sync-text-main">{{ pendingCount }} 条待备份</text>
        <text class="sync-text-sub">联网后会自动备份，也可点下方「立即备份」</text>
      </block>
      <block wx:else>
        <text class="sync-text-main">已备份到云端</text>
        <text class="sync-text-sub">共 {{ totalGames }} 条战绩</text>
      </block>
    </view>
  </view>

  <!-- 等级卡片（免费 / Pro 分层） -->
  <view class="tier-card {{ isPro ? 'tier-card-pro' : 'tier-card-free' }}">
    <view class="tier-head">
      <view class="tier-badge">{{ isPro ? 'PRO' : 'FREE' }}</view>
      <view class="tier-title-wrap">
        <text class="tier-title">{{ isPro ? 'Pro 版' : '免费版' }}</text>
        <text class="tier-sub">{{ isPro ? '已解锁全部 Pro 权益' : '¥9.9 一次性解锁全部权益' }}</text>
      </view>
      <view class="tier-action" bindtap="onUpgrade">
        <text>{{ isPro ? '权益' : '升级' }}</text>
      </view>
    </view>
    <view class="tier-body">
      <view class="tier-line">
        <text class="tier-dot"></text>
        <text class="tier-line-text">战绩分享海报 + 小程序码（所有人免费）</text>
      </view>
      <view class="tier-line">
        <text class="tier-dot"></text>
        <text class="tier-line-text">{{ isPro ? '克星榜全量 + 战绩复盘解锁' : '克星榜仅看 TOP1（升级看全部）' }}</text>
      </view>
      <view class="tier-line">
        <text class="tier-dot"></text>
        <text class="tier-line-text">{{ isPro ? '月度战报随时看' : '月度战报（升级解锁）' }}</text>
      </view>
      <view class="tier-line">
        <text class="tier-dot"></text>
        <text class="tier-line-text">{{ isPro ? '云端全量保留，不限天数' : '云端只保存最近 ' + cloudWindowDates + ' 天（升级全量）' }}</text>
      </view>
      <view class="tier-line">
        <text class="tier-dot"></text>
        <text class="tier-line-text">AI 复盘点评（即将上线）</text>
      </view>
    </view>
  </view>

  <!-- 菜单区 -->
  <view wx:for="{{ menuSections }}" wx:key="title" class="menu-section section-card">
    <view class="menu-title">
      <text>{{ item.title }}</text>
      <view wx:if="{{ item.title === '数据管理' }}" class="menu-title-line"></view>
    </view>
    <view wx:for="{{ item.items }}" wx:for-item="menu" wx:key="id"
          class="menu-row"
          bindtap="onMenuTap"
          data-id="{{ menu.id }}">
      <view class="menu-icon-wrap menu-icon-{{ menu.iconType }}">
        <text class="menu-icon">{{ menu.icon }}</text>
      </view>
      <view class="menu-content">
        <view class="menu-name">{{ menu.title }}</view>
        <view class="menu-desc">{{ menu.desc }}</view>
      </view>
      <view wx:if="{{ menu.action === 'switch' }}" class="menu-switch">
        <switch checked="{{ menu.value }}"
                color="#534AB7"
                data-id="{{ menu.id }}"
                bindchange="onSwitchChange" />
      </view>
      <view wx:else class="menu-arrow">
        <text>›</text>
      </view>
    </view>
  </view>

  <!-- 联系客服：open-type=contact 唤起微信官方客服会话（付款问题/退款咨询入口） -->
  <button class="contact-btn" open-type="contact" session-from="profile">💬 联系客服</button>

  <!-- 底部 -->
  <view class="footer">
    <view class="footer-logo">
      <text>🀄</text>
    </view>
    <view class="footer-text">雀战录 v{{ version }}</view>
    <view class="footer-text-sub">{{ buildTime }}</view>
  </view>

</view>
<!-- 换头像半屏面板：内置 20 头像九宫格 + 微信头像 -->
<view class="avatar-picker-mask {{ avatarPickerVisible ? 'is-visible' : '' }}" bindtap="onAvatarPickerClose">
  <view class="avatar-picker-panel" catchtap="noop">
    <view class="avatar-picker-title">更换头像</view>
    <view class="avatar-grid">
      <view wx:for="{{ avatarList }}" wx:key="*this"
            class="avatar-cell {{ accountAvatar === item ? 'is-current' : '' }}"
            data-idx="{{ index + 1 }}" bindtap="onPickBuiltinAvatar">
        <image class="avatar-cell-img" src="{{ item }}" mode="aspectFill" />
      </view>
    </view>
    <button class="avatar-picker-wechat-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">使用微信头像</button>
  </view>
</view>

<!-- 登录抽屉（未登录时由 utils/auth 弹出；登录成功回调刷新页面数据） -->
<login-drawer id="loginDrawer" bind:loggedin="onLoggedIn" />
