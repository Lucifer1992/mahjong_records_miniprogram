<!-- pages/index/index.wxml -->
<view class="page">

  <!-- 顶部 Hero 区 -->
  <view class="hero">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <view class="hero-greeting">
        <view class="hero-title">{{ greeting }}<text class="hero-emoji">🀄</text></view>
        <view class="hero-subtitle">{{ todayText }}</view>
      </view>
      <view class="hero-stats">
        <view class="hero-stat">
          <view class="hero-stat-num">{{ totalGames }}</view>
          <view class="hero-stat-label">累计场次</view>
        </view>
        <view class="hero-stat-divider"></view>
        <view class="hero-stat">
          <view class="hero-stat-num">{{ totalPlayers }}</view>
          <view class="hero-stat-label">牌友</view>
        </view>
        <view class="hero-stat-divider"></view>
        <view class="hero-stat">
          <view class="hero-stat-num">{{ winRate }}<text class="hero-stat-pct">%</text></view>
          <view class="hero-stat-label">总胜率</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 玩法 + 时段 -->
  <view class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">玩法设置</text>
      </view>
    </view>

    <picker mode="selector" range="{{ rules }}" range-key="name"
            value="{{ selectedRuleIndex }}" bindchange="onRuleChange">
      <view class="picker-row">
        <text class="picker-label">玩法</text>
        <view class="picker-value">
          <text class="picker-value-text">{{ selectedRule.name }}</text>
          <text class="picker-arrow">›</text>
        </view>
      </view>
    </picker>

    <view wx:if="{{ selectedRule.id === 'custom' }}" class="custom-rule-input-wrap">
      <input id="customRuleInput"
             class="custom-rule-input"
             type="text"
             maxlength="{{ customRuleNameMax }}"
             placeholder="如「办公室麻将」「四人血战」"
             placeholder-class="custom-rule-placeholder"
             value="{{ customRuleDraft }}"
             bindinput="onCustomRuleInput"
             confirm-hold="{{ false }}" />
      <view wx:if="{{ customRuleDraft.length === 0 }}" class="custom-rule-hint">
        点击输入你的玩法名称（{{ customRuleNameMax }} 字以内）
      </view>
    </view>

    <view class="form-divider"></view>

    <view class="form-row">
      <text class="picker-label">时段</text>
      <view class="duration-list">
        <view wx:for="{{ durations }}" wx:key="id"
              class="duration-chip {{ selectedDurationIndex === index ? 'duration-chip-active' : '' }}"
              data-index="{{ index }}" bindtap="onDurationSelect">
          <text class="duration-icon">{{ item.icon }}</text>
          <text>{{ item.name }}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 真实牌桌：4 方位头像 + 中心本局 ===== -->
  <view class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">本局牌桌</text>
      </view>
      <view wx:if="{{ players.length >= 2 }}" class="score-badge {{ scoreValid ? 'score-badge-pos' : 'score-badge-neg' }}">
        总和 {{ totalScore }} {{ scoreValid ? '✓' : '≠ 0' }}
      </view>
    </view>

    <!-- 当日累计（自动按 2h 间隔切分会话） -->
    <view wx:if="{{ players.length >= 2 }}" class="daily-strip">
      <view class="daily-strip-item">
        <view class="daily-strip-num">{{ dailyStats.games }}</view>
        <view class="daily-strip-label">当日局数</view>
      </view>
      <view class="daily-strip-divider"></view>
      <view class="daily-strip-item">
        <view class="daily-strip-num {{ dailyStats.netScore > 0 ? 'is-pos' : dailyStats.netScore < 0 ? 'is-neg' : '' }}">
          {{ dailyStats.netScore > 0 ? '+' : '' }}{{ dailyStats.netScore }}
        </view>
        <view class="daily-strip-label">当日累计</view>
      </view>
    </view>

    <!-- 牌桌（含背景图 + 4 头像 + 中心） -->
    <view class="table-wrap" catchtap="onCancelDrag">
      <image class="table-bg" src="/assets/mahjong-table.jpg" mode="aspectFill"></image>

      <!-- 中心：本局总分 + 第几局（仅在有人开始计分时显示，开局前空着让玩家能看清四向头像） -->
      <view wx:if="{{ players.length >= 2 && hasAnyScore }}" class="table-center">
        <view class="center-round-num">第 {{ dailyStats.games + 1 }} 局</view>
        <view class="center-round-score">
          <text wx:if="{{ totalScore >= 0 }}">+{{ totalScore }}</text>
          <text wx:else>{{ totalScore }}</text>
        </view>
        <view class="center-round-status">
          <text wx:if="{{ scoreValid }}" class="ok">平账 ✓</text>
          <text wx:else class="warn">不平账</text>
        </view>
      </view>

      <!-- 北（上） -->
      <view wx:if="{{ seats.north }}" class="seat seat-north {{ dragSource === 'north' ? 'seat-dragging' : (dragSource && dragSource !== 'north' ? 'seat-drop-target' : '') }}">
        <view class="seat-pos-label pos-north">北</view>
        <view class="seat-avatar {{ seats.north.isEvil ? 'seat-avatar-evil' : '' }}"
              data-seat="north"
              bindtap="onTapSeat"
              bindlongpress="onLongPressSeat"
              catchtouchend="onTapSeat">
          <image class="seat-avatar-img" src="/assets/avatars/avatar-{{ seats.north.avatarIdx < 10 ? '0' : '' }}{{ seats.north.avatarIdx }}.png" mode="aspectFill" />
        </view>
        <view wx:if="{{ seats.north.score > 0 || seats.north.score < 0 }}" class="seat-score {{ seats.north.score < 0 ? 'is-neg' : '' }}">
          <text wx:if="{{ seats.north.score > 0 }}">+{{ seats.north.score }}</text>
          <text wx:else>{{ seats.north.score }}</text>
        </view>
        <view wx:if="{{ seats.north.isEvil }}" class="seat-evil-tag">克星</view>
      </view>
      <view wx:else class="seat seat-north seat-empty" data-seat="north" bindtap="onTapEmptySeat">
        <view class="seat-pos-label pos-north">北</view>
        <view class="seat-avatar-empty">+</view>
      </view>

      <!-- 东（右）：label 在右侧 -->
      <view wx:if="{{ seats.east }}" class="seat seat-east-row {{ dragSource === 'east' ? 'seat-dragging' : (dragSource && dragSource !== 'east' ? 'seat-drop-target' : '') }}">
        <view class="seat-avatar {{ seats.east.isEvil ? 'seat-avatar-evil' : '' }}"
              data-seat="east"
              bindtap="onTapSeat"
              bindlongpress="onLongPressSeat"
              catchtouchend="onTapSeat">
          <image class="seat-avatar-img" src="/assets/avatars/avatar-{{ seats.east.avatarIdx < 10 ? '0' : '' }}{{ seats.east.avatarIdx }}.png" mode="aspectFill" />
        </view>
        <view class="seat-pos-label pos-east">东</view>
        <view wx:if="{{ seats.east.score > 0 || seats.east.score < 0 }}" class="seat-score {{ seats.east.score < 0 ? 'is-neg' : '' }}">
          <text wx:if="{{ seats.east.score > 0 }}">+{{ seats.east.score }}</text>
          <text wx:else>{{ seats.east.score }}</text>
        </view>
        <view wx:if="{{ seats.east.isEvil }}" class="seat-evil-tag">克星</view>
      </view>
      <view wx:else class="seat seat-east-row seat-empty" data-seat="east" bindtap="onTapEmptySeat">
        <view class="seat-avatar-empty">+</view>
        <view class="seat-pos-label pos-east">东</view>
      </view>

      <!-- 南（下）：label 在下方 -->
      <view wx:if="{{ seats.south }}" class="seat seat-south-col {{ dragSource === 'south' ? 'seat-dragging' : (dragSource && dragSource !== 'south' ? 'seat-drop-target' : '') }}">
        <view class="seat-avatar {{ seats.south.isEvil ? 'seat-avatar-evil' : '' }}"
              data-seat="south"
              bindtap="onTapSeat"
              bindlongpress="onLongPressSeat"
              catchtouchend="onTapSeat">
          <image class="seat-avatar-img" src="/assets/avatars/avatar-{{ seats.south.avatarIdx < 10 ? '0' : '' }}{{ seats.south.avatarIdx }}.png" mode="aspectFill" />
        </view>
        <view class="seat-pos-label pos-south">南</view>
        <view wx:if="{{ seats.south.score > 0 || seats.south.score < 0 }}" class="seat-score {{ seats.south.score < 0 ? 'is-neg' : '' }}">
          <text wx:if="{{ seats.south.score > 0 }}">+{{ seats.south.score }}</text>
          <text wx:else>{{ seats.south.score }}</text>
        </view>
        <view wx:if="{{ seats.south.isEvil }}" class="seat-evil-tag">克星</view>
      </view>
      <view wx:else class="seat seat-south-col seat-empty" data-seat="south" bindtap="onTapEmptySeat">
        <view class="seat-avatar-empty">+</view>
        <view class="seat-pos-label pos-south">南</view>
      </view>

      <!-- 西（左）：label 在左侧 -->
      <view wx:if="{{ seats.west }}" class="seat seat-west-row {{ dragSource === 'west' ? 'seat-dragging' : (dragSource && dragSource !== 'west' ? 'seat-drop-target' : '') }}">
        <view class="seat-pos-label pos-west">西</view>
        <view class="seat-avatar {{ seats.west.isEvil ? 'seat-avatar-evil' : '' }}"
              data-seat="west"
              bindtap="onTapSeat"
              bindlongpress="onLongPressSeat"
              catchtouchend="onTapSeat">
          <image class="seat-avatar-img" src="/assets/avatars/avatar-{{ seats.west.avatarIdx < 10 ? '0' : '' }}{{ seats.west.avatarIdx }}.png" mode="aspectFill" />
        </view>
        <view wx:if="{{ seats.west.score > 0 || seats.west.score < 0 }}" class="seat-score {{ seats.west.score < 0 ? 'is-neg' : '' }}">
          <text wx:if="{{ seats.west.score > 0 }}">+{{ seats.west.score }}</text>
          <text wx:else>{{ seats.west.score }}</text>
        </view>
        <view wx:if="{{ seats.west.isEvil }}" class="seat-evil-tag">克星</view>
      </view>
      <view wx:else class="seat seat-west-row seat-empty" data-seat="west" bindtap="onTapEmptySeat">
        <view class="seat-pos-label pos-west">西</view>
        <view class="seat-avatar-empty">+</view>
      </view>
    </view>

    <!-- 添加牌友入口 -->
    <view class="add-player-row">
      <view class="recent-btn" bindtap="onShowRecentPlayers">
        <text class="recent-btn-icon">📋</text>
        <text class="recent-btn-text">历史牌友</text>
      </view>
      <input class="add-player-input"
             placeholder="输入牌友昵称"
             placeholder-class="input-placeholder"
             value="{{ newPlayerName }}"
             bindinput="onPlayerInput"
             bindconfirm="onAddPlayer"
             maxlength="10" />
      <view wx:if="{{ showAddMe }}" class="add-me-btn" bindtap="onAddMe">＋ 我</view>
      <view class="add-btn {{ newPlayerName ? 'add-btn-active' : '' }}" bindtap="onAddPlayer">
        <text class="add-btn-icon">+</text>
        <text>添加</text>
      </view>
    </view>

    <!-- 头像选择器（输入昵称后显示） -->
    <view wx:if="{{ newPlayerName }}" class="avatar-picker">
      <view class="avatar-picker-label">选头像</view>
      <scroll-view scroll-x class="avatar-picker-scroll">
        <view class="avatar-picker-list">
          <view wx:for="{{ avatarOptions }}" wx:key="index"
                class="avatar-picker-item {{ (selectedAvatarIdx || suggestedAvatarIdx) === index + 1 ? 'is-selected' : '' }}"
                data-idx="{{ index + 1 }}"
                catchtap="onSelectAvatar">
            <image src="{{ item }}" mode="aspectFill" />
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{ players.length === 0 }}" class="player-empty-tip">
      添加 2-4 位牌友，按东→南→西→北 入座
    </view>
    <view wx:elif="{{ players.length < 2 }}" class="player-empty-tip">
      至少需要 {{ 2 - players.length }} 位牌友才能开打
    </view>
    <view wx:elif="{{ !scoreValid }}" class="player-empty-tip warn">
      💡 点任一头像弹计分卡，4 人分数合计需为 0
    </view>
  </view>

  <!-- 心情 -->
  <view wx:if="{{ players.length >= 2 }}" class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">今天的心情</text>
      </view>
      <text class="section-meta">可选</text>
    </view>

    <view class="mood-list">
      <view wx:for="{{ moods }}" wx:key="id"
            class="mood-item {{ selectedMood === item.id ? 'mood-item-active' : '' }}"
            data-mood="{{ item.id }}"
            bindtap="onMoodSelect">
        <view class="mood-emoji">{{ item.icon }}</view>
        <text class="mood-name">{{ item.name }}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view wx:if="{{ players.length >= 2 }}" class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">备注</text>
      </view>
      <text class="section-meta">{{ note.length }} / 100</text>
    </view>
    <textarea class="note-input"
              placeholder="如：胡了把大牌、点炮三次、最后一把翻盘..."
              placeholder-class="input-placeholder"
              value="{{ note }}"
              bindinput="onNoteInput"
              maxlength="100"
              auto-height></textarea>
  </view>

</view>

<!-- 底部操作栏 -->
<view wx:if="{{ players.length >= 2 }}" class="action-bar">
  <view class="action-bar-inner">
    <view class="btn-secondary" bindtap="onFinish">
      <text>查看战绩</text>
    </view>
    <view class="btn-primary-action {{ saveEnabled ? '' : 'btn-disabled' }}"
           bindtap="onSave">
      <text class="btn-primary-icon">✓</text>
      <text>保存本局</text>
    </view>
  </view>
</view>

<!-- ===== 中央计分弹窗（C 方案：关闭只点 X，禁止蒙层点击关闭） ===== -->
<view wx:if="{{ showScoreModal }}" class="modal-mask">
  <view class="modal" catchtap="">
    <view class="modal-header">
      <view class="modal-title">
        正在编辑 <text class="modal-title-name">{{ activePlayerNickname || '' }}</text>
      </view>
      <view class="modal-close" catchtap="onCloseScoreModal">✕</view>
    </view>

    <view class="modal-body">
      <view wx:for="{{ modalSeats }}" wx:key="seat"
            class="modal-row {{ item.seat === modalActiveSeat ? 'is-active' : '' }}"
            data-seat="{{ item.seat }}"
            catchtap="onModalSelectSeat">
        <view class="modal-row-pos">{{ item.seatLabel }}</view>
        <view class="modal-row-avatar {{ item.isEvil ? 'is-evil' : '' }}">
          <image class="modal-avatar-img" src="/assets/avatars/avatar-{{ item.avatarIdx < 10 ? '0' : '' }}{{ item.avatarIdx }}.png" mode="aspectFill" />
        </view>
        <view class="modal-row-info">
          <view class="modal-row-name">{{ item.nickname }}</view>
          <view wx:if="{{ item.isEvil }}" class="modal-row-evil">克星</view>
        </view>
        <view class="modal-row-input-wrap">
          <view class="modal-sign-toggle {{ item.negative ? 'is-neg' : '' }}"
                data-seat="{{ item.seat }}"
                catchtap="onModalToggleSign">
            <text>{{ item.negative ? '−' : '+' }}</text>
          </view>
          <input class="modal-score-input"
                 type="number"
                 placeholder="0"
                 value="{{ item.scoreText }}"
                 data-seat="{{ item.seat }}"
                 bindinput="onModalScoreInput" />
        </view>
      </view>
    </view>

    <view class="modal-divider"></view>

    <view class="modal-quick">
      <view class="modal-quick-label">快捷分数</view>
      <view class="modal-quick-list">
        <view class="modal-quick-btn" data-value="-10" catchtap="onModalQuickScore">−10</view>
        <view class="modal-quick-btn" data-value="-5" catchtap="onModalQuickScore">−5</view>
        <view class="modal-quick-btn modal-quick-btn-pos" data-value="5" catchtap="onModalQuickScore">+5</view>
        <view class="modal-quick-btn modal-quick-btn-pos" data-value="10" catchtap="onModalQuickScore">+10</view>
        <view class="modal-quick-btn" data-value="20" catchtap="onModalQuickScore">+20</view>
      </view>
    </view>

    <view class="modal-footer">
      <view class="modal-total {{ scoreValid ? 'is-ok' : 'is-warn' }}">
        总和 {{ totalScore }} {{ scoreValid ? '✓' : '≠ 0' }}
      </view>
      <view class="modal-save-btn {{ saveEnabled ? '' : 'is-disabled' }}" catchtap="onModalSave">
        保存本局
      </view>
    </view>
  </view>
</view>

<!-- 头像快捷分数小菜单（长按头像 + 按钮触发；点选即生效） -->
<view wx:if="{{ quickScoreMenuSeat }}" class="quick-menu-mask" catchtap="onCloseQuickScoreMenu">
  <view class="quick-menu" catchtap="">
    <view class="quick-menu-title">快速加减（带符号）</view>
    <view class="quick-menu-grid">
      <view class="quick-menu-btn is-neg" data-value="-10" catchtap="onQuickScoreMenuPick">−10</view>
      <view class="quick-menu-btn is-neg" data-value="-5" catchtap="onQuickScoreMenuPick">−5</view>
      <view class="quick-menu-btn" data-value="5" catchtap="onQuickScoreMenuPick">+5</view>
      <view class="quick-menu-btn" data-value="10" catchtap="onQuickScoreMenuPick">+10</view>
      <view class="quick-menu-btn" data-value="20" catchtap="onQuickScoreMenuPick">+20</view>
      <view class="quick-menu-btn is-neg" data-value="-20" catchtap="onQuickScoreMenuPick">−20</view>
    </view>
    <view class="quick-menu-cancel" catchtap="onCloseQuickScoreMenu">取消</view>
  </view>
</view>

<!-- 历史牌友抽屉（多选：勾多位 → 底部「加入本局」一次性加入） -->
<view class="recent-mask {{ showRecentPlayers ? 'is-visible' : '' }}"
      bindtap="onCloseRecentPlayers"
      wx:if="{{ showRecentPlayers }}">
  <view class="recent-panel" catchtap="">
    <view class="recent-close" bindtap="onCloseRecentPlayers">✕</view>
    <view class="recent-title">历史牌友</view>
    <view class="recent-sub">按 东→南→西→北 顺序勾选入座</view>

    <scroll-view scroll-x class="recent-combo-scroll" wx:if="{{ recentLineups.length > 0 }}">
      <view class="recent-combo-list">
        <view wx:for="{{ recentLineups }}" wx:key="id"
              class="recent-combo"
              data-index="{{ index }}"
              catchtap="onApplyLineup"
              hover-class="recent-combo-hover">
          <view class="recent-combo-label">{{ item.label }}</view>
          <view class="recent-combo-text">{{ item.text }}</view>
        </view>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="recent-scroll">
      <!-- + 我 快捷按钮 -->
      <view wx:if="{{ showAddMe }}" class="recent-add-me-btn" catchtap="onAddMe">＋ 我</view>

      <view wx:for="{{ recentPlayers }}" wx:key="id"
            class="recent-row {{ item.inGame ? 'recent-row-ingame' : '' }}"
            data-index="{{ index }}"
            catchtap="onToggleRecentPlayer"
            bindlongpress="onLongPressRecentPlayer"
            hover-class="recent-row-hover">
        <view class="recent-avatar-wrap">
          <image class="recent-avatar-img" src="/assets/avatars/avatar-{{ item.avatarIdx >= 1 && item.avatarIdx <= 20 ? (item.avatarIdx < 10 ? '0' : '') + item.avatarIdx : '01' }}.png"
                 mode="aspectFill" />
        </view>
        <view class="recent-info">
          <view class="recent-name-row">
            <view class="recent-name">{{ item.nickname }}</view>
            <view wx:if="{{ item.nextSeat != null && item.checked && !item.inGame }}"
                  class="recent-seat-badge seat-{{ item.nextSeat }}">
              {{ item.nextSeat === 'east' ? '东' : item.nextSeat === 'south' ? '南' : item.nextSeat === 'west' ? '西' : '北' }}
            </view>
          </view>
          <view class="recent-meta">
            <text wx:if="{{ item.usage > 0 }}">打过 {{ item.usage }} 局</text>
            <text wx:else>未参战（仅档案）</text>
          </view>
        </view>
        <view wx:if="{{ item.inGame }}" class="recent-tag">已在局</view>
        <view wx:else class="recent-check {{ item.checked ? 'is-checked' : '' }}">
          <text wx:if="{{ item.checked }}" class="recent-check-icon">✓</text>
        </view>
      </view>
      <view wx:if="{{ recentPlayers.length === 0 }}" class="recent-empty">
        暂无历史牌友
      </view>
    </scroll-view>

    <view class="recent-confirm {{ recentCheckedCount > 0 ? '' : 'is-disabled' }}"
          catchtap="onConfirmAddRecent">
      <text wx:if="{{ recentCheckedCount > 0 }}">入座牌桌 ({{ recentCheckedCount }})</text>
      <text wx:else>勾选牌友后入座</text>
    </view>
  </view>
</view>

<!-- 更换头像弹层（长按历史牌友触发；点选即生效） -->
<view wx:if="{{ showAvatarEditor }}" class="avatar-editor-mask" bindtap="onCloseAvatarEditor">
  <view class="avatar-editor" catchtap="">
    <view class="avatar-editor-close" catchtap="onCloseAvatarEditor">✕</view>
    <view class="avatar-editor-title">更换头像</view>
    <view class="avatar-editor-sub">{{ avatarEditorName }}</view>
    <view class="avatar-editor-grid">
      <view wx:for="{{ avatarOptions }}" wx:key="index"
            class="avatar-editor-cell {{ avatarEditorIdx === index + 1 ? 'is-current' : '' }}"
            data-idx="{{ index + 1 }}"
            catchtap="onAvatarEditorPick">
        <image src="{{ item }}" mode="aspectFill" />
      </view>
    </view>
  </view>
</view>

<!-- 登录抽屉（未登录时由 utils/auth 弹出；登录成功回调刷新页面数据） -->
<login-drawer id="loginDrawer" bind:loggedin="onLoggedIn" />