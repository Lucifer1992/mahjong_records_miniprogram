<!-- pages/index/index.wxml -->
<view class="page">

  <!-- 顶部 Hero 区 -->
  <view class="hero">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <view class="hero-greeting">
        <view class="hero-title">{{ greeting }}<text class="hero-emoji">🀄</text></view>
        <view class="hero-subtitle">{{ todayText }}</view>
      </view>
      <view class="hero-stats">
        <view class="hero-stat">
          <view class="hero-stat-num">{{ totalGames }}</view>
          <view class="hero-stat-label">累计场次</view>
        </view>
        <view class="hero-stat-divider"></view>
        <view class="hero-stat">
          <view class="hero-stat-num">{{ totalPlayers }}</view>
          <view class="hero-stat-label">牌友</view>
        </view>
        <view class="hero-stat-divider"></view>
        <view class="hero-stat">
          <view class="hero-stat-num">{{ winRate }}<text class="hero-stat-pct">%</text></view>
          <view class="hero-stat-label">总胜率</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 玩法 + 时段 -->
  <view class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">玩法设置</text>
      </view>
    </view>

    <picker mode="selector" range="{{ rules }}" range-key="name"
            value="{{ selectedRuleIndex }}" bindchange="onRuleChange">
      <view class="picker-row">
        <text class="picker-label">玩法</text>
        <view class="picker-value">
          <text class="picker-value-text">{{ selectedRule.name }}</text>
          <text class="picker-arrow">›</text>
        </view>
      </view>
    </picker>

    <!-- 自定义玩法：占满下一行的灰色 placeholder 输入框，点击即编辑 -->
    <view wx:if="{{ selectedRule.id === 'custom' }}" class="custom-rule-input-wrap">
      <input id="customRuleInput"
             class="custom-rule-input"
             type="text"
             maxlength="{{ customRuleNameMax }}"
             placeholder="如「办公室麻将」「四人血战」"
             placeholder-class="custom-rule-placeholder"
             value="{{ customRuleDraft }}"
             bindinput="onCustomRuleInput"
             confirm-hold="{{ false }}" />
      <view wx:if="{{ customRuleDraft.length === 0 }}" class="custom-rule-hint">
        点击输入你的玩法名称（{{ customRuleNameMax }} 字以内）
      </view>
    </view>

    <view class="form-divider"></view>

    <view class="form-row">
      <text class="picker-label">时段</text>
      <view class="duration-list">
        <view wx:for="{{ durations }}" wx:key="id"
              class="duration-chip {{ selectedDurationIndex === index ? 'duration-chip-active' : '' }}"
              data-index="{{ index }}" bindtap="onDurationSelect">
          <text class="duration-icon">{{ item.icon }}</text>
          <text>{{ item.name }}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 玩家选择 -->
  <view class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">牌友</text>
      </view>
      <text class="section-meta">{{ players.length }} / 4 人</text>
    </view>

    <view wx:if="{{ players.length > 0 }}" class="player-chips">
      <view wx:for="{{ players }}" wx:key="playerId"
            class="player-chip"
            data-index="{{ index }}"
            bindtap="onTapPlayer"
            hover-class="player-chip-hover"
            hover-stay-time="60">
        <view class="player-chip-avatar avatar-grad-{{ item.avatarIdx || 1 }}">
          {{ item.nickname[0] }}
        </view>
        <text class="player-chip-name">{{ item.nickname }}</text>
        <view class="chip-remove" data-index="{{ index }}" catchtap="onRemovePlayer">
          <text>×</text>
        </view>
      </view>
    </view>

    <view wx:else class="player-empty">
      <text class="player-empty-icon">👥</text>
      <text class="player-empty-text">先添加几位牌友开始记分吧</text>
    </view>

    <view class="add-player-row">
      <view class="recent-btn" bindtap="onShowRecentPlayers">
        <text class="recent-btn-icon">📋</text>
        <text class="recent-btn-text">历史牌友</text>
      </view>
      <input class="add-player-input"
             placeholder="输入牌友昵称"
             placeholder-class="input-placeholder"
             value="{{ newPlayerName }}"
             bindinput="onPlayerInput"
             bindconfirm="onAddPlayer"
             maxlength="10" />
      <view wx:if="{{ showAddMe }}" class="add-me-btn" bindtap="onAddMe">＋ 我</view>
      <view class="add-btn {{ newPlayerName ? 'add-btn-active' : '' }}" bindtap="onAddPlayer">
        <text class="add-btn-icon">+</text>
        <text>添加</text>
      </view>
    </view>
  </view>

  <!-- 分数录入 -->
  <view wx:if="{{ players.length > 0 }}" class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">本局分数</text>
      </view>
      <view class="score-badge {{ scoreValid ? 'score-badge-pos' : 'score-badge-neg' }}">
        总和 {{ totalScore }} {{ scoreValid ? '✓' : '≠ 0' }}
      </view>
    </view>

    <view wx:for="{{ players }}" wx:key="playerId" class="score-row">
      <view class="score-player">
        <view class="avatar avatar-sm avatar-grad-{{ item.avatarIdx || 1 }}">
          {{ item.nickname[0] }}
        </view>
        <text class="score-player-name">{{ item.nickname }}</text>
      </view>
      <view class="score-input-wrap">
        <view class="sign-toggle {{ item.negative ? 'sign-toggle-neg' : '' }}"
              data-index="{{ index }}"
              bindtap="onToggleSign">
          <text>{{ item.negative ? '−' : '+' }}</text>
        </view>
        <input class="score-input"
               type="number"
               placeholder="0"
               placeholder-class="input-placeholder"
               value="{{ item.scoreText }}"
               data-index="{{ index }}"
               bindinput="onScoreInput" />
      </view>
    </view>

    <view wx:if="{{ !scoreValid }}" class="score-hint">
      <text class="score-hint-icon">💡</text>
      <text class="score-hint-text">所有人分数相加应等于 0。点左侧「+ / −」切换赢分 / 输分</text>
    </view>
  </view>

  <!-- 心情 -->
  <view wx:if="{{ players.length > 0 }}" class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">今天的心情</text>
      </view>
      <text class="section-meta">可选</text>
    </view>

    <view class="mood-list">
      <view wx:for="{{ moods }}" wx:key="id"
            class="mood-item {{ selectedMood === item.id ? 'mood-item-active' : '' }}"
            data-mood="{{ item.id }}"
            bindtap="onMoodSelect">
        <view class="mood-emoji">{{ item.icon }}</view>
        <text class="mood-name">{{ item.name }}</text>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view wx:if="{{ players.length > 0 }}" class="card section-card">
    <view class="section-header">
      <view class="section-title-wrap">
        <view class="section-bar"></view>
        <text class="section-title">备注</text>
      </view>
      <text class="section-meta">{{ note.length }} / 100</text>
    </view>
    <textarea class="note-input"
              placeholder="如：胡了把大牌、点炮三次、最后一把翻盘..."
              placeholder-class="input-placeholder"
              value="{{ note }}"
              bindinput="onNoteInput"
              maxlength="100"
              auto-height></textarea>
  </view>

  <!-- 底部空状态：未添加玩家 -->
  <view wx:if="{{ players.length === 0 }}" class="empty-state">
    <view class="empty-illustration">
      <text class="empty-emoji">🀄</text>
    </view>
    <text class="empty-title">开始你的第一局</text>
    <text class="empty-subtitle">添加 2-4 位牌友，记录第一场战绩</text>
  </view>

</view>

<!-- 底部操作栏 -->
<view wx:if="{{ players.length > 0 }}" class="action-bar">
  <view class="action-bar-inner">
    <view class="btn-secondary" bindtap="onFinish">
      <text>查看战绩</text>
    </view>
    <view class="btn-primary-action {{ saveEnabled ? '' : 'btn-disabled' }}"
          bindtap="onSave">
      <text class="btn-primary-icon">✓</text>
      <text>保存本局</text>
    </view>
  </view>
</view>
<!-- 历史牌友抽屉（多选：勾多位 → 底部「加入本局」一次性加入；顶部常用阵容一键勾选） -->
<view class="recent-mask {{ showRecentPlayers ? 'is-visible' : '' }}"
      bindtap="onCloseRecentPlayers"
      wx:if="{{ showRecentPlayers }}">
  <view class="recent-panel" catchtap="">
    <view class="recent-close" bindtap="onCloseRecentPlayers">✕</view>
    <view class="recent-title">历史牌友</view>
    <view class="recent-sub">可勾选多位一起加入 · 长按可删除档案</view>

    <!-- 常用阵容（按最近 10 场自动统计，点一次勾上、再点一次取消） -->
    <scroll-view scroll-x class="recent-combo-scroll" wx:if="{{ recentLineups.length > 0 }}">
      <view class="recent-combo-list">
        <view wx:for="{{ recentLineups }}" wx:key="id"
              class="recent-combo"
              data-index="{{ index }}"
              catchtap="onApplyLineup"
              hover-class="recent-combo-hover">
          <view class="recent-combo-label">{{ item.label }}</view>
          <view class="recent-combo-text">{{ item.text }}</view>
        </view>
      </view>
    </scroll-view>

    <scroll-view scroll-y class="recent-scroll">
      <view wx:for="{{ recentPlayers }}" wx:key="id"
            class="recent-row {{ item.inGame ? 'recent-row-ingame' : '' }}"
            data-index="{{ index }}"
            catchtap="onToggleRecentPlayer"
            bindlongpress="onLongPressRecentPlayer"
            hover-class="recent-row-hover">
        <view class="recent-avatar avatar-grad-{{ (index % 8) + 1 }}">
          {{ item.nickname[0] }}
        </view>
        <view class="recent-info">
          <view class="recent-name">{{ item.nickname }}</view>
          <view class="recent-meta">
            <text wx:if="{{ item.usage > 0 }}">打过 {{ item.usage }} 局</text>
            <text wx:else>未参战（仅档案）</text>
          </view>
        </view>
        <view wx:if="{{ item.inGame }}" class="recent-tag">已在局</view>
        <view wx:else class="recent-check {{ item.checked ? 'is-checked' : '' }}">
          <text wx:if="{{ item.checked }}" class="recent-check-icon">✓</text>
        </view>
      </view>
      <view wx:if="{{ recentPlayers.length === 0 }}" class="recent-empty">
        暂无历史牌友
      </view>
    </scroll-view>

    <view class="recent-confirm {{ recentCheckedCount > 0 ? '' : 'is-disabled' }}"
          catchtap="onConfirmAddRecent">
      <text wx:if="{{ recentCheckedCount > 0 }}">加入本局（{{ recentCheckedCount }}）</text>
      <text wx:else>勾选牌友后加入</text>
    </view>
  </view>
</view>

<!-- 登录抽屉（未登录时由 utils/auth 弹出；登录成功回调刷新页面数据） -->
<login-drawer id="loginDrawer" bind:loggedin="onLoggedIn" />
