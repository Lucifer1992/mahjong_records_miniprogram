/* pages/index/index.wxss — 精修版 */

.page {
  padding: 0 0 240rpx 0;
  min-height: 100vh;
}

/* ===== Hero 区 ===== */
.hero {
  position: relative;
  padding: 32rpx 32rpx 48rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 360rpx;
  background: linear-gradient(160deg, #4A9D7E 0%, #5BAA89 50%, #84C9AB 100%);
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
}

.hero-bg::before {
  content: '';
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 280rpx; height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-bg::after {
  content: '';
  position: absolute;
  bottom: 40rpx; left: -40rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-content {
  position: relative;
  z-index: 1;
  color: #fff;
  padding-top: 80rpx;
}

.hero-greeting {
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.hero-emoji {
  font-size: 36rpx;
  margin-left: 8rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 0.5rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.hero-stat {
  flex: 1;
  text-align: center;
}

.hero-stat-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  font-feature-settings: 'tnum';
  letter-spacing: -1rpx;
}

.hero-stat-pct {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.85;
}

.hero-stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.hero-stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* ===== 通用卡片 ===== */
.section-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-bar {
  width: 6rpx;
  height: 24rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.3rpx;
}

.section-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.form-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* ===== 选择行 ===== */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.picker-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-value-text {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.picker-arrow {
  color: var(--color-text-tertiary);
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

/* ===== 时段 chip ===== */
.duration-list {
  display: flex;
  gap: 12rpx;
}

.duration-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  background: var(--color-bg-surface);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
}

.duration-chip-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 500;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 12rpx rgba(74, 157, 126, 0.25);
}

.duration-icon {
  font-size: 22rpx;
}

/* ===== 玩家 chips ===== */
.player-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.player-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 14rpx 6rpx 6rpx;
  border-radius: 32rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 500;
  transition: all 0.15s ease;
}

.player-chip-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: 500;
}

.player-chip-name {
  padding: 0 4rpx;
}

.chip-remove {
  width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-surface);
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  margin-left: 2rpx;
  line-height: 1;
  font-weight: 300;
}

.chip-remove:active {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

.player-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 0 40rpx;
  color: var(--color-text-tertiary);
}

.player-empty-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
  opacity: 0.4;
}

.player-empty-text {
  font-size: 26rpx;
}

/* ===== 添加玩家输入 ===== */
.add-player-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-player-input {
  flex: 1;
  padding: 20rpx 24rpx;
  background: var(--color-bg-surface);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
}

.add-player-input:focus {
  background: var(--color-bg-card);
  border-color: var(--color-primary);
}

.input-placeholder {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.add-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 28rpx;
  background: var(--color-bg-surface);
  color: var(--color-text-tertiary);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.15s ease;
}

.add-btn-active {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(74, 157, 126, 0.25);
}

.add-btn:active {
  transform: scale(0.96);
}

.add-btn-icon {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

/* ===== 分数录入 ===== */
.score-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
}

.score-badge-pos {
  background: var(--color-success-tint);
  color: var(--color-success);
}

.score-badge-neg {
  background: var(--color-danger-tint);
  color: var(--color-danger);
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.score-row:last-child {
  border-bottom: 0;
}

.score-player {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-player-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.score-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 正负切换按钮 */
.sign-toggle {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--color-success-tint);
  color: var(--color-success);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.sign-toggle-neg {
  background: var(--color-danger-tint);
  color: var(--color-danger);
}

.sign-toggle:active {
  transform: scale(0.9);
}

.score-input {
  width: 150rpx;
  padding: 14rpx 20rpx;
  background: var(--color-bg-surface);
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: right;
  color: var(--color-text);
  border: 1rpx solid transparent;
  font-feature-settings: 'tnum';
  transition: all 0.15s ease;
}

.score-input:focus {
  background: var(--color-bg-card);
  border-color: var(--color-primary);
  box-shadow: 0 0 0 4rpx rgba(74, 157, 126, 0.08);
}

.score-hint {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--color-warning-soft);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: var(--color-warning);
  line-height: 1.5;
}

.score-hint-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}

.score-hint-text {
  flex: 1;
}

/* ===== 心情 ===== */
.mood-list {
  display: flex;
  gap: 16rpx;
}

.mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: var(--color-bg-surface);
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.mood-item-active {
  background: var(--color-primary-tint);
  border-color: var(--color-primary);
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(74, 157, 126, 0.15);
}

.mood-emoji {
  font-size: 40rpx;
  margin-bottom: 4rpx;
  line-height: 1;
}

.mood-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.mood-item-active .mood-name {
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 备注 ===== */
.note-input {
  width: 100%;
  min-height: 100rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg-surface);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
  line-height: 1.6;
}

.note-input:focus {
  background: var(--color-bg-card);
  border-color: var(--color-primary);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx 120rpx;
  color: var(--color-text-tertiary);
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-tint) 0%, var(--color-primary-soft) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

.empty-illustration::before {
  content: '';
  position: absolute;
  inset: -16rpx;
  border-radius: 50%;
  border: 1rpx dashed var(--color-primary);
  opacity: 0.3;
}

.empty-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.empty-subtitle {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24rpx);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}

.action-bar-inner {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.btn-secondary {
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: var(--color-bg-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:active {
  background: var(--color-border-strong);
  transform: scale(0.98);
}

.btn-primary-action {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 157, 126, 0.3);
  letter-spacing: 0.5rpx;
  transition: all 0.15s ease;
}

.btn-primary-action:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(74, 157, 126, 0.35);
}

.btn-primary-icon {
  font-size: 28rpx;
  font-weight: 600;
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}