/* pages/index/index.wxss — 牌桌布局版 */

.page {
  padding: 0 0 240rpx 0;
  min-height: 100vh;
}

/* ===== 换位撤销悬浮按钮 ===== */
.undo-fab {
  position: fixed;
  top: 24rpx;
  right: 24rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #E8E5DD;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  font-size: 24rpx;
  color: #4A9D7E;
  font-weight: 500;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  transition: transform 0.15s;
}

.undo-fab:active,
.undo-fab-active {
  transform: scale(0.95);
  background: #F0F7F3;
}

.undo-fab-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.undo-fab-text {
  font-size: 22rpx;
}

/* ===== Hero 区 ===== */
.hero {
  position: relative;
  padding: 32rpx 32rpx 48rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 360rpx;
  background: linear-gradient(160deg, #4A9D7E 0%, #5BAA89 50%, #84C9AB 100%);
  border-radius: 0 0 48rpx 48rpx;
  z-index: 0;
}

.hero-bg::before {
  content: '';
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 280rpx; height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-bg::after {
  content: '';
  position: absolute;
  bottom: 40rpx; left: -40rpx;
  width: 200rpx; height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-content {
  position: relative;
  z-index: 1;
  color: #fff;
  padding-top: 80rpx;
}

.hero-greeting {
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
}

.hero-emoji {
  font-size: 36rpx;
  margin-left: 8rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 0.5rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.hero-stat {
  flex: 1;
  text-align: center;
}

.hero-stat-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  font-feature-settings: 'tnum';
  letter-spacing: -1rpx;
}

.hero-stat-pct {
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.85;
}

.hero-stat-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.hero-stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* ===== 通用卡片 ===== */
.section-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-bg-card);
  box-shadow: var(--shadow-md);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-bar {
  width: 6rpx;
  height: 24rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  letter-spacing: -0.3rpx;
}

.section-meta {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.form-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0;
}

/* ===== 自定义玩法输入 ===== */
.custom-rule-input-wrap {
  padding: 16rpx 0 4rpx;
  animation: custom-rule-fade 0.18s ease-out;
}

@keyframes custom-rule-fade {
  from { opacity: 0; transform: translateY(-4rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.custom-rule-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg);
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.custom-rule-placeholder {
  color: var(--color-text-muted, #B0AFA8);
}

.custom-rule-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted, #B0AFA8);
}

/* ===== 选择行 ===== */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.picker-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.picker-value-text {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.picker-arrow {
  color: var(--color-text-tertiary);
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

/* ===== 时段 chip ===== */
.duration-list {
  display: flex;
  gap: 12rpx;
}

.duration-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  background: var(--color-bg-surface);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
}

.duration-chip-active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 500;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 12rpx rgba(74, 157, 126, 0.25);
}

.duration-icon {
  font-size: 22rpx;
}

/* ===== 当日累计条 ===== */
.daily-strip {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #EAF3DE 0%, #D8E8C5 100%);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
}

.daily-strip-item {
  flex: 1;
  text-align: center;
}

.daily-strip-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #173404;
  line-height: 1.2;
  font-feature-settings: 'tnum';
}

.daily-strip-num.is-pos {
  color: #27500A;
}

.daily-strip-num.is-neg {
  color: #A32D2D;
}

.daily-strip-label {
  font-size: 20rpx;
  color: #4A5D3F;
  margin-top: 2rpx;
}

.daily-strip-divider {
  width: 1rpx;
  height: 36rpx;
  background: rgba(74, 157, 126, 0.25);
}

/* ===== 牌桌 ===== */
.table-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #2D5530;
}

.table-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
}

/* 中心：本局总分 */
.table-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 26%;
  height: 26%;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.center-round-num {
  font-size: 20rpx;
  color: #27500A;
  font-weight: 500;
}

.center-round-score {
  font-size: 38rpx;
  font-weight: 700;
  color: #173404;
  line-height: 1.1;
  margin: 4rpx 0;
  font-feature-settings: 'tnum';
}

.center-round-status {
  font-size: 18rpx;
  font-weight: 500;
}

.center-round-status .ok {
  color: #27500A;
}

.center-round-status .warn {
  color: #A32D2D;
}

/* ===== 4 个方位 ===== */
.seat {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 东/西：头像和标签水平排列 */
.seat-east-row,
.seat-west-row {
  flex-direction: row;
  align-items: center;
}

/* 南：列布局（与默认 .seat 相同，但用专门 class 避免冲突）*/
.seat-south-col {
  flex-direction: column;
}

/* 绝对位置 */
.seat-north {
  top: 4%;
  left: 50%;
  transform: translateX(-50%);
}

.seat-east-row {
  top: 50%;
  right: 4%;
  transform: translateY(-50%);
}

.seat-south-col {
  bottom: 4%;
  left: 50%;
  transform: translateX(-50%);
}

.seat-west-row {
  top: 50%;
  left: 4%;
  transform: translateY(-50%);
}

/* 方位小标签（白底圆角胶囊 + 棕色字，融入牌桌） */
.seat-pos-label {
  font-size: 18rpx;
  font-weight: 600;
  color: #5F4A2A;
  background: rgba(255, 255, 255, 0.92);
  padding: 1rpx 8rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

/* 北：标签在头像上方 */
.pos-north { margin-bottom: 4rpx; }

/* 南：标签在头像下方 */
.pos-south { margin-top: 4rpx; }

/* 东：标签在头像右侧 */
.pos-east { margin-left: 4rpx; }

/* 西：标签在头像左侧 */
.pos-west { margin-right: 4rpx; }

/* 头像（正圆，白底裁掉 aspectFill 超出白角） */
.seat-avatar {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: white;
  border: 3rpx solid #97C459;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.15s ease;
}

/* 头像内图片：填满容器 */
.seat-avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.seat-avatar:active {
  transform: scale(0.95);
}

/* 拖拽中：选中的源头像抬起 */
.seat-dragging .seat-avatar {
  transform: scale(1.15) translateY(-8rpx);
  border-color: #173404;
  border-width: 5rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
}

/* 其他位置：拖拽模式下提示"点我对调" */
.seat-drop-target .seat-avatar {
  border-color: #4A9D7E;
  border-style: dashed;
  animation: pulse-target 1.2s ease-in-out infinite;
}

@keyframes pulse-target {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

/* 克星红边 */
.seat-avatar-evil {
  border-color: #E24B4A;
  border-width: 4rpx;
}

/* 真实卡通头像图片 */
.seat-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 头像下方分数 */
.seat-score {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #173404;
  background: rgba(255, 255, 255, 0.92);
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  font-feature-settings: 'tnum';
}

.seat-score.is-neg {
  color: #A32D2D;
}

/* 克星小红标 */
.seat-evil-tag {
  position: absolute;
  top: -8rpx;
  left: -16rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: white;
  background: #E24B4A;
  padding: 2rpx 10rpx;
  border-radius: 12rpx;
  z-index: 2;
}

/* 右下角 + 按钮（加减分用） */
.seat-plus { display: none; }   /* 旧右下角 +5 按钮已下线，保留选择器占位以防将来复用 */

/* 3 人局空位 */
.seat-empty .seat-avatar-empty {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  border: 3rpx dashed rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 300;
}

.seat-empty:active .seat-avatar-empty {
  background: rgba(255, 255, 255, 0.55);
}

/* ===== 添加牌友 ===== */
.add-player-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recent-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: var(--color-bg-surface, #F7F5F0);
  font-size: 24rpx;
  color: var(--color-text-secondary, #4A9D7E);
}

.recent-btn:active {
  opacity: 0.6;
}

.recent-btn-icon {
  font-size: 28rpx;
}

.recent-btn-text {
  font-weight: 500;
}

.add-player-input {
  flex: 1;
  padding: 20rpx 24rpx;
  background: var(--color-bg-surface);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
}

.add-player-input:focus {
  background: var(--color-bg-card);
  border-color: var(--color-primary);
}

.input-placeholder {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}

.add-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 20rpx 28rpx;
  background: var(--color-bg-surface);
  color: var(--color-text-tertiary);
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.15s ease;
}

.add-btn-active {
  background: var(--color-primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(74, 157, 126, 0.25);
}

.add-btn:active {
  transform: scale(0.96);
}

.add-btn-icon {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1;
}

/* 「+ 我」按钮 */
.add-me-btn {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 68rpx;
  border-radius: 36rpx;
  border: 2rpx solid #4A9D7E;
  color: #4A9D7E;
  font-size: 26rpx;
  font-weight: 500;
  background: rgba(74, 157, 126, 0.08);
}

.add-me-btn:active {
  transform: scale(0.95);
  background: rgba(74, 157, 126, 0.18);
}

.player-empty-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

.player-empty-tip.warn {
  color: #A32D2D;
}

/* ===== 分数 badge（顶部总览） ===== */
.score-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
}

.score-badge-pos {
  background: var(--color-success-tint);
  color: var(--color-success);
}

.score-badge-neg {
  background: var(--color-danger-tint);
  color: var(--color-danger);
}

/* ===== 心情 ===== */
.mood-list {
  display: flex;
  gap: 16rpx;
}

.mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: var(--color-bg-surface);
  transition: all 0.2s ease;
  border: 2rpx solid transparent;
}

.mood-item-active {
  background: var(--color-primary-tint);
  border-color: var(--color-primary);
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 16rpx rgba(74, 157, 126, 0.15);
}

.mood-emoji {
  font-size: 40rpx;
  margin-bottom: 4rpx;
  line-height: 1;
}

.mood-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.mood-item-active .mood-name {
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 备注 ===== */
.note-input {
  width: 100%;
  min-height: 100rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg-surface);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
  box-sizing: border-box;
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
  line-height: 1.6;
}

.note-input:focus {
  background: var(--color-bg-card);
  border-color: var(--color-primary);
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24rpx);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}

.action-bar-inner {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.btn-secondary {
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: var(--color-bg-surface);
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:active {
  background: var(--color-border-strong);
  transform: scale(0.98);
}

.btn-primary-action {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(74, 157, 126, 0.3);
  letter-spacing: 0.5rpx;
  transition: all 0.15s ease;
}

.btn-primary-action:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(74, 157, 126, 0.35);
}

.btn-primary-icon {
  font-size: 28rpx;
  font-weight: 600;
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ===== 中央计分弹窗（C 方案） ===== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal {
  width: 100%;
  max-width: 640rpx;
  background: white;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  animation: modal-pop 0.2s ease-out;
}

@keyframes modal-pop {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.modal-title-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary, #4A9D7E);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  border-radius: 50%;
}

.modal-close:active {
  background: var(--color-bg-surface);
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--color-bg-surface);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.15s, background 0.15s;
}

.modal-row.is-active {
  border-color: var(--color-primary, #4A9D7E);
  background: #F0F7F3;
}

.modal-row-pos {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FAEEDA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #633806;
}

.modal-row-avatar {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
}

.modal-avatar-img {
  width: 100%;
  height: 100%;
}

.modal-row-avatar.is-evil {
  box-shadow: 0 0 0 3rpx #E24B4A;
}

.modal-row-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.modal-row-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.modal-row-evil {
  font-size: 20rpx;
  font-weight: 600;
  color: #A32D2D;
}

.modal-row-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.modal-sign-toggle {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #EAF3DE;
  color: #173404;
  font-size: 32rpx;
  font-weight: 600;
}

.modal-sign-toggle.is-neg {
  background: #FCEBEB;
  color: #A32D2D;
}

.modal-sign-toggle:active {
  transform: scale(0.92);
}

.modal-score-input {
  width: 120rpx;
  height: 56rpx;
  padding: 0 16rpx;
  background: white;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  color: var(--color-text);
  border: 1rpx solid var(--color-border);
  font-feature-settings: 'tnum';
  box-sizing: border-box;
}

.modal-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 24rpx 0 16rpx;
}

.modal-quick {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.modal-quick-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.modal-quick-list {
  display: flex;
  gap: 8rpx;
  flex: 1;
}

.modal-quick-btn {
  flex: 1;
  padding: 12rpx 0;
  text-align: center;
  background: white;
  border: 1rpx solid var(--color-border);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
}

.modal-quick-btn-pos {
  background: #97C459;
  border-color: #639922;
  color: white;
}

.modal-quick-btn:active {
  transform: scale(0.95);
}

.modal-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.modal-total {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  padding: 0 16rpx;
  font-feature-settings: 'tnum';
}

.modal-total.is-ok {
  color: #27500A;
}

.modal-total.is-warn {
  color: #A32D2D;
}

.modal-save-btn {
  flex: 1;
  padding: 22rpx 0;
  background: #97C459;
  color: white;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(74, 157, 126, 0.25);
}

.modal-save-btn.is-disabled {
  opacity: 0.45;
}

.modal-save-btn:active {
  transform: scale(0.98);
}

/* ===== 历史牌友抽屉 ===== */
.recent-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  transition: opacity 0.2s ease-out;
}

.recent-mask.is-visible {
  opacity: 1;
}

.recent-panel {
  position: relative;
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 56rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
  transform: translateY(100%);
  transition: transform 0.24s ease-out;
}

.recent-mask.is-visible .recent-panel {
  transform: translateY(0);
}

.recent-close {
  position: absolute;
  top: 24rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #B0AFA8;
}

.recent-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2B2A26;
  text-align: center;
}

.recent-sub {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: #9B9A93;
  text-align: center;
}

.recent-combo-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.recent-combo-list {
  display: inline-flex;
  align-items: stretch;
}

.recent-combo {
  flex: none;
  max-width: 320rpx;
  margin-right: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-primary-tint, #F1FAF6);
  border: 1rpx solid rgba(74, 157, 126, 0.28);
}

.recent-combo-hover {
  background: var(--color-primary-soft, #E8F5EF);
}

.recent-combo-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary-deep, #2D6951);
}

.recent-combo-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5F5E5A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-scroll {
  max-height: 48vh;
}

.recent-row {
  display: flex;
  align-items: center;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #F1EFE8;
}

.recent-row:last-child {
  border-bottom: none;
}

.recent-row-ingame {
  opacity: 0.45;
}

.recent-tag {
  flex: none;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F1EFE8;
  font-size: 20rpx;
  color: #9B9A93;
}

.recent-check {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-left: 12rpx;
  border-radius: 50%;
  border: 2rpx solid #C4C2B9;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recent-check.is-checked {
  border-color: var(--color-primary, #4A9D7E);
  background: var(--color-primary, #4A9D7E);
}

.recent-check-icon {
  font-size: 24rpx;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 600;
}

.recent-confirm {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  background: var(--color-primary, #4A9D7E);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.recent-confirm.is-disabled {
  background: #D8D6CE;
  color: #FFFFFF;
}

.recent-row-hover {
  background: #F7F5F0;
}

.recent-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;          /* 昵称和方位预告之间留更宽间距，避免视觉贴脸 */
}

.recent-name {
  flex: none;
}

.recent-seat-badge {
  flex: none;
  padding: 2rpx 10rpx;       /* 上下 padding 让标签与基线有呼吸空间 */
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: #fff;
  line-height: 1.4;
  margin-left: 2rpx;          /* 双重保险：再加点左间距 */
}

/* 抽屉方位预告标签背景（独立类名 .recent-seat-{seat}，避免与主牌桌 .seat-north 等类名冲突） */
.recent-seat-badge.recent-seat-east,
.recent-seat-badge.recent-seat-south,
.recent-seat-badge.recent-seat-west,
.recent-seat-badge.recent-seat-north {
  background: var(--color-primary, #4A9D7E);
}

.recent-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.recent-info {
  flex: 1;
  min-width: 0;
}

.recent-name {
  font-size: 28rpx;
  color: #2B2A26;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9B9A93;
}

.recent-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9B9A93;
}

/* ===== 头像相关 ===== */

/* 历史牌友抽屉：用真实图片替代文字头像 */
.recent-avatar-wrap {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  background: #F0EDE8;
}

.recent-avatar-img {
  width: 100%;
  height: 100%;
}

/* 「+ 我」快捷按钮 */
.recent-add-me-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  margin: 0 0 12rpx 0;
  border-radius: 16rpx;
  background: var(--color-primary, #4A9D7E);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.recent-add-me-btn:active {
  opacity: 0.8;
}

/* ===== 头像选择器 ===== */
.avatar-picker {
  padding: 16rpx 24rpx;
  background: #FAFAF7;
  border-top: 1rpx solid #F0EDE8;
}

.avatar-picker-label {
  font-size: 22rpx;
  color: #9B9A93;
  margin-bottom: 12rpx;
}

.avatar-picker-scroll {
  white-space: nowrap;
}

.avatar-picker-list {
  display: flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.avatar-picker-item {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.15s, transform 0.15s;
}

.avatar-picker-item.is-selected {
  border-color: var(--color-primary, #4A9D7E);
  transform: scale(1.12);
}

.avatar-picker-item:active {
  opacity: 0.75;
}

.avatar-picker-item image {
  width: 100%;
  height: 100%;
}

/* ===== 更换头像弹层 ===== */
.avatar-editor-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1100;   /* 高于计分弹窗(999)与历史牌友抽屉(998) */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.avatar-editor {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 28rpx 32rpx;
  box-sizing: border-box;
  animation: modal-pop 0.2s ease-out;
}

.avatar-editor-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9B9A93;
  border-radius: 50%;
}

.avatar-editor-close:active {
  background: #F1EFE8;
}

.avatar-editor-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2B2A26;
}

.avatar-editor-sub {
  margin-top: 6rpx;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #9B9A93;
}

.avatar-editor-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.avatar-editor-cell {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: border-color 0.15s, transform 0.15s;
}

.avatar-editor-cell.is-current {
  border-color: var(--color-primary, #4A9D7E);
}

.avatar-editor-cell:active {
  transform: scale(0.92);
}

.avatar-editor-cell image {
  width: 100%;
  height: 100%;
}

/* ===== 头像快捷分数小弹层（已下线：分数录入统一走计分弹窗）===== */
/* ===== Banner 广告（仅免费用户渲染）===== */
.ad-banner {
  margin: 24rpx 24rpx 40rpx;
}

/* ===== 「本人」小标（历史牌友列表里标识自己的档案）===== */
.recent-me-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(74, 157, 126, 0.12);
  color: #4A9D7E;
  font-size: 20rpx;
  line-height: 1.4;
}
